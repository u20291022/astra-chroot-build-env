#!/usr/bin/env python3
# astra-get — пакетный менеджер для Astra Linux поверх astra-chroot-build-env.
# https://github.com/u20291022/astra-chroot-build-env
#
# Ставит программы, собранные для современного Debian, на старую систему:
#   astra-get install https://github.com/zed-industries/zed     готовый релиз GitHub
#   astra-get install htop-dev/htop                             нет релиза -> сборка из исходников
#   astra-get install deb:krita                                 пакет Debian trixie из chroot
# Работает на python3 3.7 (Astra 1.7), только стандартная библиотека.

import argparse
import hashlib
import json
import mmap
import os
import re
import shlex
import shutil
import struct
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile

VERSION = "2.3.0"

HOME = os.path.expanduser("~")
OPT = os.environ.get("BUILD_ENV_OPT", os.path.join(HOME, ".local/opt/buildenv"))
BIN = os.environ.get("BUILD_ENV_BIN", os.path.join(HOME, ".local/bin"))
APPS = os.environ.get("BUILD_ENV_APPS", os.path.join(HOME, ".local/share/applications"))
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "astra-get")
GH_API = os.environ.get("ASTRA_GET_GH_API", "https://api.github.com").rstrip("/")
GH_WEB = os.environ.get("ASTRA_GET_GH_WEB", "https://github.com").rstrip("/")
UA = "astra-get/" + VERSION
LIBDIRS = ["/usr/lib/x86_64-linux-gnu", "/lib/x86_64-linux-gnu", "/usr/lib", "/lib", "/lib64",
           "/usr/local/lib", "/usr/lib/x86_64-linux-gnu/pulseaudio"]

PRESETS = {  # известные программы: имя -> (источник, регулярка файла релиза)
    "zed": ("github:zed-industries/zed", r"^zed-linux-x86_64\.tar\.gz$"),
    "helium": ("github:imputnet/helium-linux", r"x86_64_linux\.tar\.xz$"),
    "uv": ("github:astral-sh/uv", r"^uv-x86_64-unknown-linux-gnu\.tar\.gz$"),
    # готовый переносимый CPython (собран под glibc 2.17, работает и на Astra); только релизы X.Y.Z
    "python": ("github:astral-sh/python-build-standalone",
               r"^cpython-3\.\d+\.\d+\+\d+-x86_64-unknown-linux-gnu-install_only_stripped\.tar\.gz$"),
    "clash-verge": ("github:clash-verge-rev/clash-verge-rev", r"_amd64\.deb$"),
    "clash-verge-rev": ("github:clash-verge-rev/clash-verge-rev", r"_amd64\.deb$"),
}


def preset_for(word):
    """'python@3.13' -> ('python', источник, регулярка) или None."""
    base, _, ver = word.partition("@")
    if base not in PRESETS:
        return None
    src, rx = PRESETS[base]
    if base == "python" and ver:
        if not re.match(r"^3\.\d+$", ver):
            raise Fail("укажите версию Python как 3.13")
        rx = rx.replace(r"3\.\d+\.", re.escape(ver) + r"\.", 1)
    return (base if not ver else "%s%s" % (base, ver)), src, rx


def preset_links(name, tree):
    """Что выводить в ~/.local/bin для известных программ, если не всё подряд."""
    if name.startswith("python"):
        # только версионные команды: python3 в ~/.local/bin перекрыл бы системный и сломал программы Astra
        bind = os.path.join(tree, "bin")
        out = []
        for f in sorted(os.listdir(bind)) if os.path.isdir(bind) else []:
            if re.match(r"^(python|pip)3\.\d+$", f):
                out.append("bin/" + f)
        return out or None
    return None

IS_TTY = sys.stdout.isatty()
JSON_MODE = False
PROGRESS_LINES = False


class Fail(Exception):
    pass


# --- Вывод -------------------------------------------------------------------------------
def _c(code, s):
    return "\033[%sm%s\033[0m" % (code, s) if IS_TTY else s


def say(msg):
    if not JSON_MODE:
        print(_c("1", "==> " + msg), flush=True)


def info(msg):
    if not JSON_MODE:
        print("    " + msg, flush=True)


def ok(msg):
    if not JSON_MODE:
        print("    " + _c("32", "✓") + " " + msg, flush=True)


def warn(msg):
    print("    " + _c("33", "!") + " " + msg, file=sys.stderr, flush=True)


def progress(pct):
    if PROGRESS_LINES:
        print("@@progress %d" % pct, flush=True)


# --- Окружение build-env -----------------------------------------------------------------
def chroot_path():
    c = os.environ.get("BUILD_ENV_CHROOT", "")
    cfg = os.path.join(HOME, ".config/astra-build-env/config")
    if not c and os.path.isfile(cfg):
        for line in open(cfg, encoding="utf-8", errors="replace"):
            if line.startswith("CHROOT="):
                c = line.split("=", 1)[1].strip().strip("'\"")
    return (c or os.path.join(HOME, ".local/share/astra-build-env/trixie")).rstrip("/")


def tool(name):
    p = os.path.join(BIN, name)
    if os.access(p, os.X_OK):
        return p
    p = shutil.which(name)
    if not p:
        raise Fail("не найден %s — установите astra-chroot-build-env (install.sh)" % name)
    return p


class Session:
    """Один вход в build-env (один пароль sudo) на всю работу astra-get: activate-build-env
    --session выполняет команды, которые мы присылаем построчно."""

    def __init__(self):
        self.p = None

    def start(self):
        if self.p and self.p.poll() is None:
            return
        os.makedirs(CACHE, exist_ok=True)
        env = dict(os.environ)
        say("Вход в build-env (sudo)")
        if os.environ.get("SUDO_ASKPASS"):
            info("пароль спросит отдельное окно; при входе по отпечатку сначала приложите палец")
        self.p = subprocess.Popen([tool("activate-build-env"), "--session"], cwd=CACHE, env=env,
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for line in iter(self.p.stdout.readline, b""):
            t = line.decode("utf-8", "replace").rstrip("\n")
            if t == "@@abe-session-ready":
                return
            if not JSON_MODE and t.strip():
                print("      " + t, flush=True)
        self.p.wait()
        self.p = None
        raise Fail("не удалось войти в build-env (неверный пароль или activate-build-env старше 1.2: "
                   "обновите скрипты через install.sh)")

    def run(self, mode, cwd, cmdline, log=None):
        if "\n" in cmdline or "\t" in cmdline or "\t" in cwd:
            raise Fail("недопустимые символы в команде")
        self.start()
        self.p.stdin.write(("%s\t%s\t%s\n" % (mode, cwd, cmdline)).encode("utf-8"))
        self.p.stdin.flush()
        out = open(log, "ab") if log else None
        rc, pending = None, None
        try:
            for line in iter(self.p.stdout.readline, b""):
                m = re.match(rb"^@@abe-rc (\d+)$", line.rstrip(b"\n"))
                if m:
                    rc = int(m.group(1))
                    break
                if pending is not None:  # перед маркером сеанс печатает пустую строку — её не показываем
                    self._emit(pending, out)
                pending = line
            if pending is not None and pending.strip():
                self._emit(pending, out)
        finally:
            if out:
                out.close()
        if rc is None:
            self.p = None
            raise Fail("сеанс build-env неожиданно завершился")
        return rc

    @staticmethod
    def _emit(line, out):
        if out:
            out.write(line)
        if not JSON_MODE:
            sys.stdout.write("      " + line.decode("utf-8", "replace"))
            sys.stdout.flush()

    def close(self):
        if self.p and self.p.poll() is None:
            try:
                self.p.stdin.close()
                self.p.wait(timeout=60)
            except (OSError, subprocess.TimeoutExpired):
                self.p.kill()
        self.p = None


SESSION = Session()


def run_env(args, root=False, cwd=None, log=None, check=True):
    """Команда внутри chroot (через общий сеанс build-env). Вывод — в консоль и в лог."""
    cwd = os.path.abspath(cwd or CACHE)
    if not (cwd + "/").startswith(os.path.abspath(CACHE) + "/"):
        raise Fail("рабочая папка вне %s: %s" % (CACHE, cwd))
    rc = SESSION.run("root" if root else "user", cwd, " ".join(shlex.quote(a) for a in args), log)
    if check and rc != 0:
        raise Fail("команда в build-env завершилась с ошибкой (%d): %s" % (rc, " ".join(args[:3])))
    return rc


def host_link(src, dst):
    return SESSION.run("hostln", src, dst) == 0


def host_unlink(path):
    return SESSION.run("hostrm", "/", path) == 0


# --- Сеть ----------------------------------------------------------------------------------
def http_get(url, api=False, data_limit=None):
    hdr = {"User-Agent": UA}
    if api:
        hdr["Accept"] = "application/vnd.github+json"
        if os.environ.get("GITHUB_TOKEN"):
            hdr["Authorization"] = "Bearer " + os.environ["GITHUB_TOKEN"]
    req = urllib.request.Request(url, headers=hdr)
    for attempt in range(3):  # сеть бывает нестабильной (VPN, прокси): повторяем, кроме ответов сервера
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.read(data_limit) if data_limit else r.read(), r.geturl()
        except urllib.error.HTTPError:
            raise
        except (urllib.error.URLError, OSError) as e:
            if attempt == 2:
                raise urllib.error.URLError(getattr(e, "reason", e))
            time.sleep(2 * (attempt + 1))


def gh_json(path):
    body, _ = http_get(GH_API + path, api=True)
    return json.loads(body.decode("utf-8"))


def download(url, dest, attempts=5):
    """Скачивание с повторами и докачкой (Range): обрывы соединения и таймауты TLS
    при нестабильной сети или VPN не начинают загрузку заново."""
    part = dest + ".part"
    if os.path.exists(part):
        os.remove(part)
    total, last = 0, -1
    for attempt in range(attempts):
        done = os.path.getsize(part) if os.path.exists(part) else 0
        hdr = {"User-Agent": UA}
        if done:
            hdr["Range"] = "bytes=%d-" % done
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=60) as r:
                if done and r.status != 206:  # сервер не умеет докачку — с начала
                    done = 0
                length = int(r.headers.get("Content-Length") or 0)
                total = done + length if length else total
                with open(part, "ab" if done else "wb") as f:
                    while True:
                        chunk = r.read(1 << 16)
                        if not chunk:
                            break
                        f.write(chunk)
                        done += len(chunk)
                        if total:
                            pct = done * 100 // total
                            if pct != last and (pct % 5 == 0 or IS_TTY):
                                last = pct
                                progress(pct)
                                if IS_TTY and not JSON_MODE:
                                    sys.stdout.write("\r    скачано %3d%%  (%d МБ)" % (pct, total >> 20))
                                    sys.stdout.flush()
            if total and done < total:
                raise OSError("соединение оборвалось на %d из %d МБ" % (done >> 20, total >> 20))
            break
        except urllib.error.HTTPError as e:
            if e.code == 416 and done:  # уже всё скачано
                break
            raise
        except (urllib.error.URLError, OSError) as e:
            if attempt == attempts - 1:
                raise urllib.error.URLError(getattr(e, "reason", e))
            if IS_TTY and not JSON_MODE:
                print()
            warn("сеть: %s — повтор %d из %d%s" % (getattr(e, "reason", e), attempt + 2, attempts,
                                                  ", докачиваю" if os.path.exists(part) and os.path.getsize(part) else ""))
            time.sleep(3 * (attempt + 1))
    if IS_TTY and not JSON_MODE:
        print()
    os.replace(part, dest)


# --- GitHub -------------------------------------------------------------------------------
def parse_spec(spec):
    """-> ('github', 'owner/repo') | ('debian', 'pkg') | ('url', url) | ('name', word)"""
    s = spec.strip()
    for p in ("deb:", "debian:"):
        if s.startswith(p):
            return "debian", s[len(p):]
    if s.startswith("github:"):
        return "github", s[7:].strip("/")
    m = re.match(r"^(?:https?://)?(?:www\.)?github\.com/([\w.-]+)/([\w.-]+?)(?:\.git)?(?:/.*)?$", s)
    if m:
        if "/releases/download/" in s:
            return "url", s if s.startswith("http") else "https://" + s
        return "github", "%s/%s" % (m.group(1), m.group(2))
    if re.match(r"^https?://", s):
        return "url", s
    if re.match(r"^[\w.-]+/[\w.-]+$", s):
        return "github", s
    if re.match(r"^[a-z0-9][a-z0-9+.-]*(@[0-9.]+)?$", s):
        return "name", s
    raise Fail("не понимаю, что ставить: %s" % spec)


def latest_release(repo):
    """-> dict(tag, assets=[(name,url)]) или None, если релизов нет."""
    try:
        j = gh_json("/repos/%s/releases/latest" % repo)
        return {"tag": j["tag_name"], "assets": [(a["name"], a["browser_download_url"]) for a in j.get("assets", [])]}
    except urllib.error.HTTPError as e:
        if e.code == 404:
            try:  # репозиторий есть, релизов нет?
                gh_json("/repos/%s" % repo)
                return None
            except urllib.error.HTTPError as e2:
                if e2.code == 404:
                    raise Fail("репозиторий %s не найден на GitHub" % repo)
    except (urllib.error.URLError, ValueError, KeyError):
        pass
    # запасной путь без API (лимит 60 запросов в час): страница релиза
    try:
        _, final = http_get(GH_WEB + "/%s/releases/latest" % repo, data_limit=1)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise Fail("GitHub не отвечает (%s); задайте GITHUB_TOKEN, если кончился лимит запросов" % e)
    except urllib.error.URLError as e:
        raise Fail("нет связи с GitHub: %s" % e)
    m = re.search(r"/releases/tag/([^/?#]+)", final)
    if not m:
        return None
    tag = urllib.parse.unquote(m.group(1))
    body, _ = http_get(GH_WEB + "/%s/releases/expanded_assets/%s" % (repo, m.group(1)))
    assets = []
    for href in sorted(set(re.findall(r'href="([^"]*/releases/download/[^"]+)"', body.decode("utf-8", "replace")))):
        url = GH_WEB + href if href.startswith("/") else href
        assets.append((urllib.parse.unquote(url.rsplit("/", 1)[1]), url))
    return {"tag": tag, "assets": assets}


BAD_EXT = re.compile(r"\.(sha\d*|sha\d+sum|md5|sig|asc|minisig|pem|crt|sbom|spdx|json|txt|yml|yaml|blockmap|"
                     r"pdb|sym|dmg|pkg|exe|msi|msix|apk|ipa|rpm|zsync|b3|nupkg|vsix|whl|snap|flatpak)$", re.I)
BAD_TOK = re.compile(r"(windows|win32|win64|\bwin\b|darwin|macos|\bmac\b|osx|apple|android|\bios\b|freebsd|openbsd|"
                     r"netbsd|aarch64|arm64|armv\d|armhf|armel|\barm\b|i[3-6]86|\b386\b|x86(?!_64|-64)|riscv|ppc|"
                     r"powerpc|s390|loong|mips|source|\bsrc\b|debug|dbg|symbols)", re.I)


def score_asset(name):
    n = name.lower()
    if BAD_EXT.search(n) or BAD_TOK.search(n.replace("x86_64", "x64").replace("x86-64", "x64")):
        return None
    linux = "linux" in n
    arch = bool(re.search(r"(x86_64|x86-64|amd64|x64)", n))
    s = 0
    if n.endswith(".deb"):
        s += 6
    elif re.search(r"\.(tar\.gz|tgz|tar\.xz|txz|tar\.bz2|tbz2?|tar)$", n):
        s += 4
    elif n.endswith(".appimage"):
        s += 3
    elif n.endswith(".zip"):
        s += 2
    elif "." not in n.rsplit("-", 1)[-1] or re.search(r"(linux|amd64|x86_64)$", n):
        s += 1   # одиночный бинарник
    else:
        return None
    if not (linux or n.endswith(".deb") or n.endswith(".appimage")):
        return None
    s += 3 if arch else -1
    s += 1 if linux else 0
    s += 1 if "musl" in n or "static" in n else 0
    return s


def pick_assets(assets, regex=None, repo=None):
    """-> отсортированный список (score, name, url), лучший первым."""
    out = []
    if not regex and repo:
        # релиз из одного бинарника без расширения с именем программы (greenclip, многие Go/Haskell-утилиты)
        base = repo.split("/")[-1].lower()
        for name, url in assets:
            n = name.lower()
            if "." not in n and not BAD_TOK.search(n) and (n == base or n.startswith(base + "-")):
                out.append((0, name, url))
    for name, url in assets:
        if regex:
            if re.search(regex, name):
                out.append((10, name, url))
            continue
        sc = score_asset(name)
        if sc is not None:
            out.append((sc, name, url))
    if regex:  # несколько файлов под одну регулярку (разные версии) — самая новая первой
        out.sort(key=lambda t: [int(x) for x in re.findall(r"\d+", t[1])][:4], reverse=True)
    else:
        out.sort(key=lambda t: (-t[0], len(t[1])))
    return out


# --- ELF без внешних утилит ----------------------------------------------------------------
def elf_info(path):
    """-> (needed: list, is_exe: bool) или None, если не ELF x86_64."""
    try:
        with open(path, "rb") as f:
            ident = f.read(64)
            if len(ident) < 64 or ident[:4] != b"\x7fELF" or ident[4] != 2 or ident[5] != 1:
                return None
            e_type, = struct.unpack_from("<H", ident, 0x10)
            static_exe = e_type == 2  # ET_EXEC: статическая программа без загрузчика (greenclip и т.п.)
            phoff, = struct.unpack_from("<Q", ident, 0x20)
            phentsize, phnum = struct.unpack_from("<HH", ident, 0x36)
            f.seek(phoff)
            ph = f.read(phentsize * phnum)
            loads, dyn, interp = [], None, False
            for i in range(phnum):
                p_type, _, p_offset, p_vaddr, _, p_filesz = struct.unpack_from("<IIQQQQ", ph, i * phentsize)
                if p_type == 1:
                    loads.append((p_vaddr, p_offset, p_filesz))
                elif p_type == 2:
                    dyn = (p_offset, p_filesz)
                elif p_type == 3:
                    interp = True
            if not dyn:
                return [], interp or static_exe
            f.seek(dyn[0])
            d = f.read(dyn[1])
            needed, strtab = [], None
            for i in range(0, len(d) - 15, 16):
                tag, val = struct.unpack_from("<qQ", d, i)
                if tag == 0:
                    break
                if tag == 1:
                    needed.append(val)
                elif tag == 5:
                    strtab = val
            if strtab is None:
                return [], interp
            base = None
            for va, off, sz in loads:
                if va <= strtab < va + sz:
                    base = strtab - va + off
            if base is None:
                return [], interp
            names = []
            for o in needed:
                f.seek(base + o)
                names.append(f.read(256).split(b"\0", 1)[0].decode("ascii", "replace"))
            return names, interp
    except (OSError, struct.error):
        return None


def is_chromium(files):
    """Chromium и всё, что на нём (Electron, браузеры на Chromium)."""
    return bool({"chrome-sandbox", "chrome_sandbox", "v8_context_snapshot.bin", "snapshot_blob.bin"} & set(files)) or \
        ("resources.pak" in files and ("icudtl.dat" in files or "libffmpeg.so" in files))


def dlopens_gpu(path):
    """Программы на wgpu/blade (Zed) грузят Vulkan через dlopen — ищем имя библиотеки в файле."""
    try:
        with open(path, "rb") as f, mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ) as m:
            return m.find(b"libvulkan.so.1") >= 0 or m.find(b"libEGL.so.1") >= 0
    except (OSError, ValueError):
        return False


def scan_tree(tree):
    """ELF-файлы дерева, их зависимости и признаки (GPU, WebKit, GTK, Qt, Electron)."""
    files, needed, exes = set(), set(), []
    for dp, dn, fn in os.walk(tree):
        for n in fn:
            p = os.path.join(dp, n)
            files.add(n)
            if os.path.islink(p) or not os.path.isfile(p):
                continue
            e = elf_info(p)
            if e is None:
                continue
            needed.update(e[0])
            if e[1] and os.access(p, os.X_OK):
                exes.append(os.path.relpath(p, tree))
    feats = set()
    has = lambda *xs: any(any(n.startswith(x) for n in needed) for x in xs)
    if has("libvulkan.so", "libGL.so", "libEGL.so", "libGLX", "libgbm.so", "libGLESv2") or \
            any(dlopens_gpu(os.path.join(tree, e)) for e in exes):
        feats.add("gpu")
    if has("libwebkit2gtk-4.1.so"):
        feats.add("webkit41")
    elif has("libwebkit2gtk-4.0.so"):
        feats.add("webkit40")
    elif has("libwebkitgtk-6.0.so"):
        feats.add("webkit6")
    if has("libgtk-3.so", "libgtk-4.so", "libgdk_pixbuf"):
        feats.add("gtk")
    for q in ("5", "6"):
        if has("libQt%sCore.so" % q) and not any(f.startswith("libQt%sCore.so" % q) for f in files):
            feats.add("qt" + q)
    if is_chromium(files):
        feats.add("electron")
    return {"files": files, "needed": sorted(needed), "exes": sorted(exes), "feats": feats}


def missing_libs(scan, chroot):
    miss = []
    for so in scan["needed"]:
        if "/" in so:  # NEEDED с путём ($ORIGIN/../lib/libpython3.so) — ищем файл внутри программы
            so = so.rsplit("/", 1)[1]
        if so in scan["files"] or so.startswith("ld-linux"):
            continue
        if not any(os.path.exists(chroot + d + "/" + so) for d in LIBDIRS):
            miss.append(so)
    return miss


# --- Пакеты в chroot -----------------------------------------------------------------------
APT_SEARCH_FUNCS = r'''
export DEBIAN_FRONTEND=noninteractive
ensure_apt_file() {
  command -v apt-file >/dev/null || apt-get install -y -q apt-file >/dev/null
  ls /var/lib/apt/lists/*Contents* >/dev/null 2>&1 || apt-file update >/dev/null
}
# find_pkg РЕГВЫР [-i] -> имя пакета (предпочтительно -dev для заголовков)
find_pkg() {
  apt-file search $2 -x "$1" 2>/dev/null | cut -d: -f1 | sort -u \
    | awk '{ print ($0 ~ /-dev$/ ? 0 : 1), length($0), $0 }' | sort -n | head -n1 | cut -d" " -f3
}
'''


def deb_depends(path):
    """Зависимости из control .deb: [[альтернатива, ...], ...] — для библиотек, которые
    программа грузит через dlopen (их нет в DT_NEEDED)."""
    try:
        dep = subprocess.check_output(["dpkg-deb", "-f", path, "Depends"]).decode("utf-8", "replace")
    except (OSError, subprocess.CalledProcessError):
        return []
    out = []
    for group in dep.split(","):
        alts = [re.sub(r"[\s(:].*$", "", a.strip()) for a in group.split("|")]
        alts = [a for a in alts if re.match(r"^[a-z0-9][a-z0-9+.-]+$", a)]
        if alts:
            out.append(alts)
    return out


def apt_install_for(patterns, workdir, log, update=True, groups=(), pre=()):
    """patterns: [(описание, регвыр, флаги)] -> ставит найденные пакеты в chroot. -> {описание: пакет}
    groups: [[пакет | альтернатива ...]] — поставить первый доступный в trixie из каждой группы."""
    if not patterns and not groups and not pre:
        return {}
    res = os.path.join(workdir, ".apt-found")
    lines = [APT_SEARCH_FUNCS, "set -e", "cd %s" % shlex.quote(workdir)]
    if update:
        lines.append("apt-get update -qq || true")
    lines += ["ensure_apt_file", ": > .apt-found", "pk=()"] + list(pre)
    for desc, rx, flags in patterns:
        lines.append('p=$(find_pkg %s %s); if [ -n "$p" ]; then printf "%%s\\t%%s\\n" %s "$p" >> .apt-found; pk+=("$p"); fi'
                     % (shlex.quote(rx), flags, shlex.quote(desc)))
    for g in groups:
        lines.append('for n in %s; do if dpkg -s "$n" >/dev/null 2>&1; then break; fi; '
                     'if apt-get install -s -qq "$n" >/dev/null 2>&1; then pk+=("$n"); '
                     'printf "%%s\\t%%s\\n" "dep:$n" "$n" >> .apt-found; break; fi; done'
                     % " ".join(shlex.quote(x) for x in g))
    lines.append('if [ ${#pk[@]} -gt 0 ]; then echo "  apt-get install ${pk[*]}"; '
                 'apt-get install -y -qq -o Dpkg::Use-Pty=0 --no-install-recommends "${pk[@]}" > .apt.out 2>&1 '
                 '|| { tail -n 30 .apt.out; exit 1; }; fi')
    script = os.path.join(workdir, ".apt.sh")
    with open(script, "w") as f:
        f.write("\n".join(lines) + "\n")
    run_env(["bash", script], root=True, cwd=workdir, log=log)
    found = {}
    if os.path.exists(res):
        for line in open(res):
            if "\t" in line:
                d, p = line.rstrip("\n").split("\t", 1)
                found[d] = p
    return found


def so_regex(so):
    return r"^/(usr/)?lib(64)?/(x86_64-linux-gnu/)?" + re.escape(so) + "$"


# --- Метаданные приложения (совместимы с update-build-env) ---------------------------------
def app_dir(name):
    return os.path.join(OPT, name)


def check_name(name):
    if not name or "/" in name or name.startswith(".") or not re.match(r"^[\w.+-]+$", name):
        raise Fail("некорректное имя: %r" % name)


def load_meta(name):
    """Читает .update (формат bash) через сам bash — надёжнее, чем разбирать кавычки."""
    m = {"SOURCE": "", "ASSET": "", "VERSION": "", "OPTS": [], "EXTRA": []}
    f = os.path.join(app_dir(name), ".update")
    if os.path.isfile(f):
        code = ('OPTS=(); EXTRA=(); . "$1"; printf "%s\\0" "$SOURCE" "$ASSET" "$VERSION"; '
                'printf "%s\\0" "${#OPTS[@]}" "${OPTS[@]}" "${#EXTRA[@]}" "${EXTRA[@]}"')
        try:
            out = subprocess.check_output(["bash", "-c", code, "x", f]).decode("utf-8", "replace").split("\0")
            m["SOURCE"], m["ASSET"], m["VERSION"] = out[0], out[1], out[2]
            n = int(out[3])
            m["OPTS"] = out[4:4 + n]
            k = int(out[4 + n])
            m["EXTRA"] = out[5 + n:5 + n + k]
        except (subprocess.CalledProcessError, ValueError, IndexError):
            warn("%s: не удалось прочитать %s" % (name, f))
    return m


def save_meta(name, m):
    q = shlex.quote
    with open(os.path.join(app_dir(name), ".update.tmp"), "w") as f:
        f.write("# astra-get: откуда обновлять эту программу\n")
        f.write("SOURCE=%s\nASSET=%s\nVERSION=%s\n" % (q(m["SOURCE"]), q(m.get("ASSET", "")), q(m.get("VERSION", ""))))
        f.write("OPTS=( %s )\n" % " ".join(q(o) for o in m.get("OPTS", [])))
        f.write("# файлы из chroot, которые кладутся в программу перед установкой\n")
        f.write("EXTRA=( %s )\n" % " ".join(q(o) for o in m.get("EXTRA", [])))
    os.replace(os.path.join(app_dir(name), ".update.tmp"), os.path.join(app_dir(name), ".update"))


def installed():
    if not os.path.isdir(OPT):
        return []
    return sorted(d for d in os.listdir(OPT) if not d.startswith(".") and os.path.isdir(os.path.join(OPT, d)))


def find_by_source(source):
    for n in installed():
        if load_meta(n)["SOURCE"] == source:
            return n
    return None


# --- Подготовка дерева программы -------------------------------------------------------------
def has_real_elf(d):
    if not os.path.isdir(d):
        return False
    for f in os.listdir(d):
        p = os.path.join(d, f)
        if not os.path.islink(p) and os.path.isfile(p) and elf_info(p) is not None:
            return True
    return False


def deb_root(dest):
    """Корень программы внутри распакованного .deb.
    Chrome, VS Code, Obsidian и др. живут в /opt/..., а в /usr/bin только ссылки на них."""
    usr = os.path.join(dest, "usr")
    app = None
    optd = os.path.join(dest, "opt")
    if os.path.isdir(optd) and not has_real_elf(os.path.join(usr, "bin")):
        for dp, dn, fn in sorted(os.walk(optd), key=lambda t: t[0].count("/")):
            if dp.count("/") - optd.count("/") > 3:
                break
            if any(elf_info(os.path.join(dp, f)) and os.access(os.path.join(dp, f), os.X_OK)
                   for f in fn if not os.path.islink(os.path.join(dp, f))):
                app = dp
                break
    if not app:
        if os.path.isdir(os.path.join(usr, "bin")) or os.path.isdir(os.path.join(usr, "lib")):
            return usr
        return dest
    for sub in ("applications", "icons", "pixmaps", "metainfo"):  # ярлык и иконки лежат вне /opt
        src = os.path.join(usr, "share", sub)
        if os.path.isdir(src) and not os.path.exists(os.path.join(app, "share", sub)):
            shutil.copytree(src, os.path.join(app, "share", sub), symlinks=True)
    bind = os.path.join(usr, "bin")
    for f in sorted(os.listdir(bind)) if os.path.isdir(bind) else []:
        p = os.path.join(bind, f)
        if os.path.islink(p):  # /usr/bin/google-chrome-stable -> /opt/google/chrome/google-chrome
            t = os.readlink(p)
            t = dest + t if t.startswith("/") else os.path.normpath(os.path.join(bind, t))
            if os.path.exists(t) and os.path.realpath(t).startswith(os.path.realpath(app) + "/"):
                os.makedirs(os.path.join(app, "bin"), exist_ok=True)
                link = os.path.join(app, "bin", f)
                if not os.path.lexists(link):
                    os.symlink(os.path.relpath(os.path.realpath(t), os.path.join(app, "bin")), link)
    return app


def deb_field(path, field):
    try:
        return subprocess.check_output(["dpkg-deb", "-f", path, field]).decode("utf-8", "replace").strip()
    except (OSError, subprocess.CalledProcessError):
        return ""


def fix_icons(tree):
    """Иконка из ярлыка, которой нет в share/icons|pixmaps (Chrome ставит её скриптом), — из png программы."""
    appd = os.path.join(tree, "share/applications")
    if not os.path.isdir(appd):
        return
    pngs = []
    for dp, dn, fn in os.walk(tree):
        if dp.count("/") - tree.count("/") > 1:
            continue
        pngs += [os.path.join(dp, f) for f in fn if f.endswith(".png") and ("logo" in f or "icon" in f)]
    for f in os.listdir(appd):
        if not f.endswith(".desktop"):
            continue
        icon = None
        for line in open(os.path.join(appd, f), encoding="utf-8", errors="replace"):
            if line.startswith("Icon="):
                icon = line[5:].strip()
                break
        if not icon or "/" in icon:
            continue
        found = False
        for sub in ("share/icons", "share/pixmaps"):
            for dp, dn, fn in os.walk(os.path.join(tree, sub)):
                if any(os.path.splitext(x)[0] == icon for x in fn):
                    found = True
        if not found and pngs:
            best = max(pngs, key=os.path.getsize)
            os.makedirs(os.path.join(tree, "share/pixmaps"), exist_ok=True)
            shutil.copy(best, os.path.join(tree, "share/pixmaps", icon + ".png"))


def extract(path, dest, name):
    """Распаковывает файл релиза в dest; -> корень дерева программы."""
    os.makedirs(dest, exist_ok=True)
    low = path.lower()
    if low.endswith(".deb"):
        subprocess.check_call(["dpkg-deb", "-x", path, dest])
        return deb_root(dest)
    if re.search(r"\.(tar\.gz|tgz|tar\.xz|txz|tar\.bz2|tbz2?|tar)$", low):
        with tarfile.open(path) as t:
            for mbr in t.getmembers():
                if mbr.name.startswith("/") or ".." in mbr.name.split("/"):
                    raise Fail("в архиве подозрительный путь: %s" % mbr.name)
            t.extractall(dest)
    elif low.endswith(".zip"):
        with zipfile.ZipFile(path) as z:
            for zi in z.infolist():
                if zi.filename.startswith("/") or ".." in zi.filename.split("/"):
                    raise Fail("в архиве подозрительный путь: %s" % zi.filename)
                out = z.extract(zi, dest)
                mode = (zi.external_attr >> 16) & 0o777
                if mode:
                    os.chmod(out, mode)
    elif low.endswith(".appimage"):
        return None  # распаковывается в chroot (рантайм AppImage может требовать новую glibc)
    else:
        os.makedirs(os.path.join(dest, "bin"), exist_ok=True)
        shutil.copy(path, os.path.join(dest, "bin", name))
        os.chmod(os.path.join(dest, "bin", name), 0o755)
        return dest
    items = [i for i in os.listdir(dest) if not i.startswith(".")]
    if len(items) == 1 and os.path.isdir(os.path.join(dest, items[0])):
        return os.path.join(dest, items[0])
    return dest


def desktop_execs(tree):
    out = []
    d = os.path.join(tree, "share/applications")
    if os.path.isdir(d):
        for f in os.listdir(d):
            if f.endswith(".desktop"):
                for line in open(os.path.join(d, f), encoding="utf-8", errors="replace"):
                    if line.startswith("Exec="):
                        cmd = line[5:].strip().strip('"').split()
                        if cmd:
                            out.append(os.path.basename(cmd[0]))
    return out


def plan_links(tree, scan, name):
    """Что вывести в ~/.local/bin."""
    bind = os.path.join(tree, "bin")
    out = []
    for e in sorted(set(desktop_execs(tree))):
        if os.path.isfile(os.path.join(bind, e)):
            out.append("bin/" + e)
        elif os.path.isfile(os.path.join(tree, e)) and os.access(os.path.join(tree, e), os.X_OK):
            out.append(e)
    if out:
        return out
    if os.path.isdir(bind):
        return []  # по умолчанию: всё исполняемое из bin/
    # нет bin/: ELF-программы в корне или на уровень ниже
    top = [e for e in scan["exes"] if e.count("/") <= 1 and not e.startswith("lib")]
    top = [e for e in top if not re.search(r"(chrome[-_]sandbox|crashpad|_handler$)", e)]
    if len(top) <= 4:
        return top
    pref = [e for e in top if os.path.basename(e).lower() in (name.lower(), name.lower().replace("-", ""))]
    return pref or top[:3]


def userns_ok():
    """Работают ли непривилегированные user namespaces (их использует песочница Chromium)."""
    try:
        return subprocess.call(["unshare", "-Ur", "true"], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL) == 0
    except OSError:
        return False


def detect_options(tree, scan, name, chroot):
    """Параметры install-binary-from-build-env и файлы из chroot по признакам программы."""
    opts, extra, notes = [], [], []
    f = scan["feats"]
    if "gpu" in f:
        opts.append("--gpu")
        notes.append("графика: Mesa/Vulkan из chroot (--gpu)")
    wk = None
    if "webkit41" in f:
        wk = "webkit2gtk-4.1"
    elif "webkit40" in f:
        wk = "webkit2gtk-4.0"
    elif "webkit6" in f:
        wk = "webkitgtk-6.0"
    if wk:
        extra.append("/usr/lib/x86_64-linux-gnu/%s=lib/%s" % (wk, wk))
        opts += ["--env", "WEBKIT_DISABLE_DMABUF_RENDERER=1"]
        notes.append("WebKitGTK: процессы WebKit копируются внутрь программы")
    if wk or "gtk" in f:
        opts += ["--env", "GIO_MODULE_DIR=@CHROOT@/usr/lib/x86_64-linux-gnu/gio/modules",
                 "--env", "GDK_PIXBUF_MODULE_FILE=@CHROOT@/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache",
                 "--env", "GTK_PATH=@CHROOT@/usr/lib/x86_64-linux-gnu/gtk-3.0",
                 "--env", "GSETTINGS_SCHEMA_DIR=@CHROOT@/usr/share/glib-2.0/schemas",
                 "--env", "XDG_DATA_DIRS=@APP@/share:@CHROOT@/usr/share:/usr/local/share:/usr/share"]
        notes.append("GTK: модули, иконки и схемы из chroot")
    for q in ("5", "6") if not ("qt5" in f and "qt6" in f) else ():
        if "qt" + q in f:
            opts += ["--env", "QT_PLUGIN_PATH=@CHROOT@/usr/lib/x86_64-linux-gnu/qt%s/plugins" % q,
                     "--env", "QML2_IMPORT_PATH=@CHROOT@/usr/lib/x86_64-linux-gnu/qt%s/qml" % q]
            notes.append("Qt%s: плагины из chroot" % q)
    if "electron" in f:
        if userns_ok():
            notes.append("Chromium/Electron: песочница через user namespaces работает")
        else:
            opts += ["--arg", "--no-sandbox"]
            notes.append("Chromium/Electron: user namespaces выключены в ядре — запуск с --no-sandbox")
    return opts, extra, notes


# --- Установка ----------------------------------------------------------------------------
class Job:
    def __init__(self, name, kind):
        check_name(name)
        self.name, self.kind = name, kind
        self.work = os.path.join(CACHE, "work", "%s-%d" % (name, int(time.time())))
        os.makedirs(self.work)
        self.log = os.path.join(self.work, "log.txt")
        self.chroot = chroot_path()
        if not os.path.isdir(self.chroot + "/usr"):
            raise Fail("chroot не найден: %s" % self.chroot)

    def cleanup(self, keep=False):
        if keep:
            info("файлы и журнал оставлены: %s" % self.work)
        else:
            shutil.rmtree(self.work, ignore_errors=True)


def resolve_missing(job, tree, scan, depends=()):
    """Ставит в chroot пакеты для недостающих библиотек (и зависимости .deb). -> оставшиеся."""
    miss = missing_libs(scan, job.chroot)
    if not miss and not depends:
        return []
    if miss:
        say("Недостающие библиотеки: %s" % ", ".join(miss))
        info("ищу пакеты Debian (первый раз apt-file скачивает индекс, это пара минут)")
    if depends:
        say("Зависимости пакета: %s" % ", ".join(" | ".join(g) for g in depends))
    found = apt_install_for([(so, so_regex(so), "") for so in miss], job.work, job.log, groups=depends)
    for so, p in sorted(found.items()):
        ok("%s ← %s" % (so, p) if not so.startswith("dep:") else p)
    left = missing_libs(scan, job.chroot)
    for so in left:
        warn("не нашёл пакет с %s — программа может не запуститься" % so)
    return left


WEBKIT = {"webkit41": ("webkit2gtk-4.1", "libwebkit2gtk-4.1.so.0"),
          "webkit40": ("webkit2gtk-4.0", "libwebkit2gtk-4.0.so.37"),
          "webkit6": ("webkitgtk-6.0", "libwebkitgtk-6.0.so.4")}


def webkit_link(name):
    return os.path.join(HOME, ".abe", hashlib.md5(name.encode()).hexdigest()[:6])


def webkit_patch(job, scan):
    """Путь к процессам WebKit зашит в библиотеку (/usr/lib/x86_64-linux-gnu/webkit2gtk-4.1),
    а WEBKIT_EXEC_PATH обычные сборки игнорируют. Кладём в программу копию библиотеки, где этот
    путь заменён на короткую ссылку ~/.abe/ID той же длины (лишнее добивается слэшами), а ссылка
    ведёт на пропатченные процессы внутри программы. -> (параметры установки, (ссылка, цель))"""
    for feat, (wk, lib) in WEBKIT.items():
        if feat not in scan["feats"]:
            continue
        orig = "/usr/lib/x86_64-linux-gnu/" + wk
        link = webkit_link(job.name)
        if len(link) > len(orig):
            warn("путь %s длиннее %s — процессы WebKit не найдутся" % (link, orig))
            return [], None
        src = os.path.realpath(job.chroot + "/usr/lib/x86_64-linux-gnu/" + lib)
        if not src.startswith(job.chroot) or not os.path.isfile(src):
            src = job.chroot + "/usr/lib/x86_64-linux-gnu/" + lib
        if not os.path.isfile(src):
            warn("в chroot нет %s" % lib)
            return [], None
        data = open(src, "rb").read()
        n = data.count(orig.encode())
        if not n:
            warn("в %s не нашёл путь к процессам WebKit" % lib)
            return [], None
        data = data.replace(orig.encode(), link.encode().ljust(len(orig), b"/"))
        out = os.path.join(job.work, "wk", lib)
        os.makedirs(os.path.dirname(out), exist_ok=True)
        with open(out, "wb") as f:
            f.write(data)
        info("WebKit: путь к процессам в %s заменён на %s" % (lib, link))
        return ["--lib", out], (link, os.path.join(app_dir(job.name), "lib", wk))
    return [], None


def drop_link_opts(opts):
    out, skip = [], False
    for o in opts:
        if skip:
            skip = False
            continue
        if o in ("--link", "-L"):
            skip = True
            continue
        out.append(o)
    return out


def strip_lib_opts(opts):
    out, skip = [], False
    for o in opts:
        if skip:
            skip = False
            continue
        if o in ("--lib", "-l"):
            skip = True
            continue
        out.append(o)
    return out


def prev_snapshot(name):
    d, p = app_dir(name), os.path.join(OPT, "." + name + ".prev")
    if os.path.isdir(d):
        shutil.rmtree(p, ignore_errors=True)
        if subprocess.call(["cp", "-al", d, p], stderr=subprocess.DEVNULL) != 0:
            subprocess.call(["cp", "-a", d, p])


def install_tree(job, tree, opts, extra, links, meta, tree_in_chroot=None, pre="", temp_opts=()):
    """Установка дерева через install-binary-from-build-env (в chroot). tree — путь на хосте."""
    script = os.path.join(job.work, ".install.sh")
    q = shlex.quote
    t = tree_in_chroot or tree
    lines = ["set -e", pre]
    for e in extra:
        src, rel = e.split("=", 1)
        lines.append("if [ -e %s ]; then mkdir -p %s; rm -rf %s; cp -a %s %s; echo %s; else echo %s >&2; fi" % (
            q(src), q(os.path.dirname(t + "/" + rel)), q(t + "/" + rel), q(src), q(t + "/" + rel),
            q("  + %s из chroot" % src), q("  ! в chroot нет %s" % src)))
    args = ["install-binary-from-build-env", "--force"] + list(opts) + list(temp_opts)
    if not any(o == "--link" for o in opts):
        for l in links:
            args += ["--link", l]
    args += ["--name", job.name, "--tree", t]
    lines.append(" ".join(q(a) for a in args))
    with open(script, "w") as f:
        f.write("\n".join(lines) + "\n")
    prev_snapshot(job.name)
    run_env(["bash", script], cwd=job.work, log=job.log)
    if not os.path.isdir(app_dir(job.name)):
        raise Fail("установка не создала %s" % app_dir(job.name))
    meta["OPTS"] = strip_lib_opts(opts)
    if not any(o == "--link" for o in opts):
        for l in links:
            meta["OPTS"] += ["--link", l]
    meta["EXTRA"] = extra
    save_meta(job.name, meta)


def root_desktop(tree, name, appimage=False):
    """Ярлык и иконка лежат в корне архива или AppImage — переносим туда, где их ищет
    install-binary-from-build-env (share/applications, share/pixmaps)."""
    pngs = [f for f in os.listdir(tree) if re.search(r"\.(png|svg|xpm)$", f) and os.path.isfile(os.path.realpath(os.path.join(tree, f)))]
    for f in os.listdir(tree):
        p = os.path.join(tree, f)
        if not (f.endswith(".desktop") and os.path.isfile(p)):
            continue
        os.makedirs(os.path.join(tree, "share/applications"), exist_ok=True)
        lines, icon = [], None
        for line in open(p, encoding="utf-8", errors="replace"):
            if line.startswith("Exec=") and appimage:
                rest = line[5:].strip().split(None, 1)
                line = "Exec=%s%s\n" % (name, (" " + rest[1]) if len(rest) > 1 else "")
            elif line.startswith("TryExec="):
                continue
            elif line.startswith("Icon=") and icon is None:
                icon = line[5:].strip()
            lines.append(line)
        dst = os.path.join(tree, "share/applications", f)
        if not os.path.exists(dst):
            with open(dst, "w") as o:
                o.writelines(lines)
        if icon and "/" not in icon:
            pick = [x for x in pngs if os.path.splitext(x)[0] == icon] or \
                sorted([x for x in pngs if "logo" in x or "icon" in x], key=lambda x: -os.path.getsize(os.path.join(tree, x)))
            if pick:
                os.makedirs(os.path.join(tree, "share/pixmaps"), exist_ok=True)
                ext = os.path.splitext(pick[0])[1]
                shutil.copy(os.path.realpath(os.path.join(tree, pick[0])), os.path.join(tree, "share/pixmaps", icon + ext))


def install_release(repo, rel, asset_name, asset_url, name, prev_meta=None, regex="", source=None, local=None):
    job = Job(name, "release")
    try:
        f = os.path.join(job.work, "dl", asset_name)
        os.makedirs(os.path.dirname(f))
        if local:
            shutil.move(local, f)
        else:
            say("%s %s: %s" % (repo, rel["tag"], asset_name))
            download(asset_url, f)
            ok("скачано (%d МБ)" % (os.path.getsize(f) >> 20))
        depends = deb_depends(f) if f.lower().endswith(".deb") else []
        tree = extract(f, os.path.join(job.work, "x"), name)
        if tree is None:  # AppImage: распаковка в chroot
            ai = os.path.join(job.work, "x")
            cmd = "cd %s && chmod +x %s && %s --appimage-extract >/dev/null" % (
                shlex.quote(ai), shlex.quote(f), shlex.quote(f))
            run_env(["bash", "-c", cmd], cwd=job.work, log=job.log)
            tree = os.path.join(ai, "squashfs-root")
            os.makedirs(os.path.join(tree, "bin"), exist_ok=True)
            link = os.path.join(tree, "bin", name)
            if not os.path.lexists(link):
                os.symlink("../AppRun", link)
            root_desktop(tree, name, appimage=True)
        return finish_tree_install(job, tree, source or "github:" + repo, rel["tag"], regex or "", prev_meta,
                                   depends=depends)
    except BaseException:
        job.cleanup(keep=True)
        raise


def finish_tree_install(job, tree, source, version, asset_regex, prev_meta, extra_notes=(), cleanup=True,
                        depends=(), links_override=None):
    names = set(os.listdir(tree))
    if is_chromium(names):
        for shim in ("libqt5_shim.so", "libqt6_shim.so"):  # необязательная тема Qt, тянет весь Qt
            if shim in names:
                os.remove(os.path.join(tree, shim))
    if not os.path.isdir(os.path.join(tree, "share/applications")):
        root_desktop(tree, job.name)
    fix_icons(tree)
    scan = scan_tree(tree)
    if not scan["exes"]:
        raise Fail("в программе нет ни одного исполняемого ELF-файла")
    if "gpu" in scan["feats"] and not os.path.isdir(job.chroot + "/usr/share/vulkan/icd.d"):
        depends = list(depends) + [["mesa-vulkan-drivers"], ["libvulkan1"], ["libegl1"], ["libgl1-mesa-dri"]]
    resolve_missing(job, tree, scan, depends)
    plinks = links_override or preset_links(job.name, tree)
    if prev_meta and prev_meta.get("OPTS"):
        opts, extra, notes = list(prev_meta["OPTS"]), list(prev_meta.get("EXTRA", [])), ["параметры прошлой установки"]
        links = []
        if plinks:  # версия Python могла смениться — ссылки считаем заново
            opts, links = drop_link_opts(opts), plinks
    else:
        opts, extra, notes = detect_options(tree, scan, job.name, job.chroot)
        links = plinks or plan_links(tree, scan, job.name)
    for n in list(extra_notes) + notes:
        info(n)
    if extra:  # библиотеки WebKit должны быть в chroot до копирования
        pk = [(e.split("=", 1)[0], "^" + re.escape(e.split("=", 1)[0]) + "/", "") for e in extra
              if not os.path.exists(job.chroot + e.split("=", 1)[0])]
        if pk:
            apt_install_for(pk, job.work, job.log, update=False)
    wk_opts, wk_link = webkit_patch(job, scan)
    say("Установка %s %s" % (job.name, version))
    meta = {"SOURCE": source, "ASSET": asset_regex, "VERSION": version}
    install_tree(job, tree, strip_lib_opts(opts), extra, links, meta, temp_opts=wk_opts)
    if wk_link:
        os.makedirs(os.path.dirname(wk_link[0]), exist_ok=True)
        if os.path.lexists(wk_link[0]):
            os.remove(wk_link[0])
        os.symlink(wk_link[1], wk_link[0])
    ok("%s %s установлен" % (job.name, version))
    if cleanup:
        job.cleanup()
    return job.name


def default_name(repo):
    n = re.sub(r"[^\w.+-]", "-", repo.split("/")[1].lower())
    return re.sub(r"[-_](releases?|binaries|bin|linux|desktop|app)$", "", n) or n


def install_github(repo, name=None, asset=None, source_build=False, force_name=False):
    existing = find_by_source("github:" + repo) or find_by_source("github-src:" + repo)
    name = name or existing or default_name(repo)
    if os.path.isdir(app_dir(name)) and name != existing and not force_name:
        other = load_meta(name)["SOURCE"]
        if other:
            raise Fail("%s уже установлен из %s — задайте другое имя (--name) или --force" % (name, other))
        info("%s уже установлен без источника обновлений — заменю и буду обновлять из GitHub" % name)
    say("GitHub: %s" % repo)
    rel = None if source_build else latest_release(repo)
    if rel:
        cand = pick_assets(rel["assets"], asset, repo)
        if cand:
            _, an, au = cand[0]
            if len(cand) > 1:
                info("выбран файл %s (другие: %s)" % (an, ", ".join(c[1] for c in cand[1:4])))
            return install_release(repo, rel, an, au, name, regex=asset or "")
        info("в релизе %s нет сборки под Linux x86_64 — соберу из исходников" % rel["tag"])
    elif not source_build:
        info("релизов нет — соберу из исходников")
    return install_source(repo, name, rel["tag"] if rel else None)


# --- Сборка из исходников ---------------------------------------------------------------------
DEP_PATTERNS = [
    (r"fatal error: ([\w./+-]+\.h): No such file", "hdr"),
    (r"([\w./+-]+\.h): No such file or directory", "hdr"),
    (r"Package '([\w.+-]+)',? (?:required by .*)?not found", "pc"),
    (r"No package '([\w.+-]+)' found", "pc"),
    (r"Package ([\w.+-]+) was not found in the pkg-config search path", "pc"),
    (r"Dependency \"?([\w.+-]+)\"? (?:found: NO|not found)", "pc"),
    (r"Run-time dependency ([\w.+-]+) found: NO", "pc"),
    (r"None of the required '([\w.+-]+)' found", "pc"),
    (r"Could NOT find ([\w]+)", "cmake"),
    (r"Could not find a package configuration file provided by \"([\w]+)\"", "cmake"),
    (r"cannot find -l([\w.+-]+)", "lib"),
    (r"Missing \(or bad\) header file: ([\w./+-]+\.h)", "hdr"),
    (r"([\w./+-]+\.h)\s*(?:\([^)\n]*\)\s*)?(?:is required|not found|was not found)", "hdr"),
    (r"The pkg-config package '([\w.+-]+)'", "pc"),
    (r"pkg-config package ([\w.+-]+)[^\n]{0,40}(?:is required|not found)", "pc"),
    (r"(?:^|\s)([\w.+-]+): (?:command )?not found", "bin"),
    (r"Program '([\w.+-]+)' not found", "bin"),
    (r"Can't exec \"([\w.+-]+)\"", "bin"),
    (r"(aclocal|autoreconf|automake|autoconf|libtoolize|pkg-config|cargo|rustc|go|meson|ninja|cmake)"
     r"[^\n]{0,40}(?:not found|No such file)", "bin"),
]


ERR_LINE = re.compile(r"(?:configure: error: |CMake Error[^:]*: |ERROR: |error: )(.+)$", re.M)
STOP = set("""cannot can't could not find found required library libraries package packages program the for
please install installed development headers header files version or and missing unable to of is are was in
with without support enable disable option a an be your system check see config log make error failed fatal
make sure set path variable no such file directory none any need needs needed requires minimum newer than
using use build building""".split())


C_SYSTEMS = ("meson", "cmake", "autotools", "make", "qmake")
NET_ERR = re.compile(r"[^\n]*(?:ReadFailed|Could not resolve host|Temporary failure in name resolution|"
                     r"Connection (?:refused|reset|timed out)|TLS|SSL|certificate verify|"
                     r"network is unreachable|failed to (?:fetch|download)|HttpConnectionFailure)[^\n]*", re.I)
DEP_HINT = re.compile(r"not found|missing|required|could not find|cannot find|no package|not installed", re.I)


def dep_groups_from_errors(text, tried):
    """Запасной путь: слова из строки ошибки configure/cmake/meson -> пакеты lib<слово>-dev."""
    groups = []
    for m in list(ERR_LINE.finditer(text))[-3:]:
        m2 = re.search(r"Package requirements \(([^)]+)\) were not met", m.group(1))
        if not m2 and not DEP_HINT.search(m.group(1)):
            continue
        words = re.findall(r"[A-Za-z][\w+-]{2,}", m2.group(1) if m2 else m.group(1))
        for w in words:
            w = w.lower().rstrip("-")
            if w in STOP or w.isdigit() or "word:" + w in tried:
                continue
            tried.add("word:" + w)
            w = re.sub(r"^lib", "", w)
            groups.append(["lib%s-dev" % w, "%s-dev" % w, "lib%sw-dev" % w])
    return groups


def dep_patterns_from_log(text, tried):
    pats = []
    # cabal/stack: "Missing (or bad) C libraries: X11, Xss"
    for m in re.finditer(r"Missing \(or bad\) C librar(?:y|ies): ([\w, .+-]+)", text):
        for v in re.findall(r"[\w.+-]+", m.group(1)):
            if "lib:" + v not in tried:
                tried.add("lib:" + v)
                pats.append(("lib:" + v, r"^/usr/lib/(x86_64-linux-gnu/)?lib" + re.escape(v) + r"\.(so|a)$", ""))
    m = re.search(r"Package requirements \(([^)]+)\) were not met", text)
    if m:
        for v in re.findall(r"([A-Za-z][\w.+-]*)", m.group(1)):
            if "pc:" + v not in tried:
                tried.add("pc:" + v)
                pats.append(("pc:" + v, r"^/usr/(lib/x86_64-linux-gnu|lib|share)/pkgconfig/" + re.escape(v) + r"\.pc$", ""))
    for rx, kind in DEP_PATTERNS:
        for m in re.finditer(rx, text, re.M):
            v = m.group(1)
            key = kind + ":" + v
            if key in tried or v in ("sh", "bash", "make", "it", "file", "error"):
                continue
            tried.add(key)
            e = re.escape(v)
            if kind == "hdr":
                pats.append((key, r"^/usr/include/(.*/)?" + e + "$", ""))
            elif kind == "pc":
                pats.append((key, r"^/usr/(lib/x86_64-linux-gnu|lib|share)/pkgconfig/" + e + r"\.pc$", ""))
            elif kind == "cmake":
                pats.append((key, r"/(%sConfig|%s-config|Find%s)\.cmake$" % (e, e, e), "-i"))
            elif kind == "lib":
                pats.append((key, r"^/usr/lib/(x86_64-linux-gnu/)?lib" + e + r"\.(so|a)$", ""))
            elif kind == "bin":
                pats.append((key, r"^/(usr/)?s?bin/" + e + "$", ""))
    return pats


BUILD_SH = r'''
set -e
cd "$SRC"
PREFIX="$BUILD_ENV_OPT/$NAME"
STAGE="$WORK/stage"
OUT="$STAGE$PREFIX"
J=$(nproc 2>/dev/null || echo 2)
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$HOME/.ghcup/bin:$PATH"
step() { echo "@@step $*"; }
need() { command -v "$1" >/dev/null || { echo "$1: command not found"; exit 127; }; }
[ -f "$WORK/.t0" ] || touch "$WORK/.t0"
# Запасной путь, когда у проекта нет установки: свежесобранные ELF-программы из исходников
collect_bins() {
  mkdir -p "$OUT/bin"
  find "$SRC" -type f -perm -u+x -newer "$WORK/.t0" ! -path '*/.git/*' ! -path '*/_abe/*' ! -name '*.so*' \
       ! -path '*/.stack-work/install/*/lib/*' -print0 \
    | while IFS= read -r -d '' f; do
        if [ "$(head -c4 "$f" | od -An -c | tr -d ' ')" = '177ELF' ]; then cp -f "$f" "$OUT/bin/"; fi
      done
  [ -n "$(ls -A "$OUT/bin")" ] || { echo "после сборки не нашлось программ"; exit 1; }
}
case "$SYSTEM" in
  cargo)
    if ! command -v cargo >/dev/null; then
      step rustup
      curl --proto '=https' -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path
    fi
    step cargo build --release
    cargo build --release --locked 2>&1 || cargo build --release
    mkdir -p "$OUT/bin"
    find target/release -maxdepth 1 -type f -perm -u+x ! -name '*.so' ! -name '*.d' -exec cp {} "$OUT/bin/" \;
    ;;
  go)
    need go; step go build
    export GOTOOLCHAIN=auto     # нужна версия Go новее Debian — скачается сама
    mkdir -p "$OUT/bin"
    if [ -d cmd ] && ! ls ./*.go >/dev/null 2>&1; then GOPKG=./cmd/...; else GOPKG=.; fi
    # Сначала без cgo: статический бинарник, патчить не нужно. Go-программы patchelf
    # с --set-rpath ломает (Segmentation fault), поэтому для cgo загрузчик и пути к
    # библиотекам chroot прописывает сам компоновщик Go (-I и -r).
    if ! CGO_ENABLED=0 go build -trimpath -o "$OUT/bin/" $GOPKG 2>&1; then
      step "go build (cgo)"
      L="$ABE_CHROOT/usr/lib/x86_64-linux-gnu:$ABE_CHROOT/lib/x86_64-linux-gnu"
      CGO_ENABLED=1 go build -trimpath \
        -ldflags "-r $L -I $ABE_CHROOT/lib64/ld-linux-x86-64.so.2" -o "$OUT/bin/" $GOPKG
    fi
    ;;
  zig)
    ZDIR="$HOME/.cache/astra-get-zig/$ZIG_VERSION"
    if [ ! -x "$ZDIR/zig" ]; then
      step "zig $ZIG_VERSION"
      mkdir -p "$ZDIR"
      curl -fsSL "$ZIG_URL" | tar -xJ -C "$ZDIR" --strip-components=1
    fi
    step zig build
    "$ZDIR/zig" build -Doptimize=ReleaseSafe --prefix "$OUT"
    ;;
  stack)
    need stack; step stack build
    stack build --install-ghc --copy-bins --local-bin-path "$OUT/bin"
    ;;
  cabal)
    need cabal; step cabal build
    cabal update
    mkdir -p "$OUT/bin"
    cabal install --installdir="$OUT/bin" --install-method=copy --overwrite-policy=always
    ;;
  meson)
    need meson; step meson
    [ -d _abe ] || meson setup _abe --prefix="$PREFIX" --buildtype=release
    ninja -C _abe -j "$J"
    DESTDIR="$STAGE" meson install -C _abe
    ;;
  cmake)
    need cmake; step cmake
    cmake -S . -B _abe -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$PREFIX"
    cmake --build _abe -j "$J"
    DESTDIR="$STAGE" cmake --install _abe || collect_bins
    ;;
  autotools)
    if [ ! -x configure ]; then
      step autogen
      if [ -x autogen.sh ]; then NOCONFIGURE=1 ./autogen.sh; else need autoreconf; autoreconf -fi; fi
    fi
    step configure; ./configure --prefix="$PREFIX"
    step make; make -j "$J"
    make install DESTDIR="$STAGE" || collect_bins
    ;;
  qmake)
    Q=$(command -v qmake6 || command -v qmake || true); [ -n "$Q" ] || { echo "qmake6: command not found"; exit 127; }
    step qmake; mkdir -p _abe; cd _abe
    "$Q" PREFIX="$PREFIX" ..
    make -j "$J"
    make install INSTALL_ROOT="$STAGE" || collect_bins
    ;;
  nim)
    need nimble; step nimble build
    nimble build -y -d:release
    collect_bins
    ;;
  dub)
    need dub; step dub build
    dub build -b release
    collect_bins
    ;;
  python)
    step "pip install (свой Python в программе)"
    mkdir -p "$OUT"
    cp -a "$PYRT" "$OUT/python"
    PY="$OUT/python/bin/python3"
    ls "$OUT/python/bin" > "$WORK/.py-before"
    "$PY" -m pip install --no-cache-dir --no-warn-script-location "$SRC"
    mkdir -p "$OUT/bin"
    for f in "$OUT"/python/bin/*; do
      b=$(basename "$f")
      grep -qxF "$b" "$WORK/.py-before" && continue
      # скрипт запускается своим Python напрямую: путь в его первой строке ведёт в папку сборки
      printf '#!/bin/sh\nd=$(dirname "$(readlink -f "$0")")\nexec "$d/../python/bin/python3" "$d/../python/bin/%s" "$@"\n' "$b" > "$OUT/bin/$b"
      chmod +x "$OUT/bin/$b"
    done
    [ -n "$(ls -A "$OUT/bin")" ] || { echo "пакет не объявляет команд (console_scripts)"; exit 1; }
    ;;
  node)
    export PATH="$NODERT/bin:$PATH"   # официальный Node.js: Debian-овский держит часть кода в /usr/share/nodejs
    need npm; step "npm (Node.js $(node --version))"
    if [ -f package-lock.json ]; then npm ci || npm install; else npm install; fi
    npm run build --if-present
    T=$(npm pack --silent | tail -n1)
    npm install -g --omit=dev --prefix "$OUT" "./$T"
    cp -L "$NODERT/bin/node" "$OUT/bin/node"
    for f in "$OUT"/bin/*; do
      b=$(basename "$f"); [ "$b" = node ] && continue
      t=$(readlink -f "$f")
      rel=${t#"$OUT"/}
      rm -f "$f"
      printf '#!/bin/sh\nd=$(dirname "$(readlink -f "$0")")\nexec "$d/node" "$d/../%s" "$@"\n' "$rel" > "$f"
      chmod +x "$f"
    done
    ;;
  make)
    step make; make -j "$J" PREFIX="$PREFIX" prefix="$PREFIX"
    make install PREFIX="$PREFIX" prefix="$PREFIX" DESTDIR="$STAGE" || collect_bins
    ;;
esac
echo "@@built"
'''


BUILD_SYSTEMS_TEXT = ("Rust (cargo), Go, Zig, Haskell (stack, cabal), C/C++ (meson, cmake, autotools, qmake, make), "
                      "Nim (nimble), D (dub), Python (pyproject/setup.py), Node.js (package.json)")


def detect_build_system(src):
    has = lambda f: os.path.exists(os.path.join(src, f))
    globs = lambda ext: any(f.endswith(ext) for f in os.listdir(src))
    if has("Cargo.toml"):
        return "cargo"
    if has("go.mod"):
        return "go"
    if has("build.zig"):
        return "zig"
    if has("stack.yaml"):
        return "stack"
    if globs(".cabal") or has("cabal.project"):
        return "cabal"
    if has("meson.build"):
        return "meson"
    if has("CMakeLists.txt"):
        return "cmake"
    if has("configure") or has("configure.ac") or has("autogen.sh"):
        return "autotools"
    if globs(".pro"):
        return "qmake"
    if globs(".nimble"):
        return "nim"
    if has("dub.json") or has("dub.sdl"):
        return "dub"
    if has("pyproject.toml") or has("setup.py"):
        return "python"
    if has("package.json"):
        try:
            if json.load(open(os.path.join(src, "package.json"))).get("bin"):
                return "node"
        except (ValueError, OSError):
            pass
    if has("Makefile") or has("makefile") or has("GNUmakefile"):
        return "make"
    return None


MAX_BUILD_ATTEMPTS = 25  # каждая попытка, кроме последней, должна что-то доставить

DEB_SRC_SH = r'''
if ! grep -rqsE '^[[:space:]]*deb-src[[:space:]]|^Types:.*deb-src' /etc/apt/sources.list /etc/apt/sources.list.d/; then
  grep -hsE '^[[:space:]]*deb[[:space:]].*debian\.org' /etc/apt/sources.list /etc/apt/sources.list.d/*.list \
    | sed -E 's/^[[:space:]]*deb([[:space:]])/deb-src\1/' > /etc/apt/sources.list.d/astra-get-src.list
  for f in /etc/apt/sources.list.d/*.sources; do
    [ -f "$f" ] && grep -q 'debian\.org' "$f" && sed -i -E 's/^Types:[[:space:]]*deb[[:space:]]*$/Types: deb deb-src/' "$f"
  done
  apt-get update -qq || true
fi
'''


def scan_build_deps(src, system):
    """Зависимости, объявленные в файлах сборки: собираем заранее, чтобы поставить одним разом."""
    pc, cm = set(), set()

    def read(rel):
        p = os.path.join(src, rel)
        return open(p, encoding="utf-8", errors="replace").read() if os.path.isfile(p) else ""
    files = []
    for dp, dn, fn in os.walk(src):
        dn[:] = [d for d in dn if not d.startswith(".") and d not in ("subprojects", "third_party", "vendor", "test",
                                                                      "tests", "_abe")]
        if dp.count("/") - src.count("/") > 3:
            dn[:] = []
        for f in fn:
            if f in ("meson.build", "CMakeLists.txt", "configure.ac", "configure.in"):
                files.append(os.path.relpath(os.path.join(dp, f), src))
    for rel in files[:60]:
        t = read(rel)
        for m in re.finditer(r"dependency\(\s*'([\w.+-]+)'([^)]*)\)", t):
            if not re.search(r"required\s*:\s*false", m.group(2)) and m.group(1) not in ("threads", "dl", "m", "rt"):
                pc.add(m.group(1))
        for m in re.finditer(r"pkg_(?:check|search)_modules\s*\(\s*\w+\s+((?:[^)]|\n)*)\)", t):
            if "REQUIRED" in m.group(1):
                for w in re.findall(r"([A-Za-z][\w.+-]*)", m.group(1)):
                    if w not in ("REQUIRED", "IMPORTED_TARGET", "QUIET", "GLOBAL", "NO_CMAKE_PATH"):
                        pc.add(w)
        for m in re.finditer(r"find_package\s*\(\s*(\w+)([^)]*)\)", t):
            if "REQUIRED" in m.group(2) and m.group(1) not in ("PkgConfig", "Threads"):
                cm.add(m.group(1))
        for m in re.finditer(r"PKG_CHECK_MODULES\(\s*\[?\w+\]?\s*,\s*\[?([^\],)]+)", t):
            for w in re.findall(r"([A-Za-z][\w.+-]*)", m.group(1)):
                pc.add(w)
    pats = [("pc:" + v, r"^/usr/(lib/x86_64-linux-gnu|lib|share)/pkgconfig/" + re.escape(v) + r"\.pc$", "")
            for v in sorted(pc)]
    pats += [("cmake:" + v, r"/(%sConfig|%s-config|Find%s)\.cmake$" % ((re.escape(v),) * 3), "-i") for v in sorted(cm)]
    return pats


def zig_release(src):
    """Версия Zig из build.zig.zon (minimum_zig_version) или последняя стабильная -> (версия, ссылка)."""
    want = None
    zon = os.path.join(src, "build.zig.zon")
    if os.path.isfile(zon):
        m = re.search(r'\.minimum_zig_version\s*=\s*"([\d.]+)"', open(zon, encoding="utf-8", errors="replace").read())
        if m:
            want = m.group(1)
    body, _ = http_get("https://ziglang.org/download/index.json")
    idx = json.loads(body.decode("utf-8"))
    vers = sorted((v for v in idx if re.match(r"^\d+\.\d+\.\d+$", v)),
                  key=lambda v: [int(x) for x in v.split(".")], reverse=True)
    key = lambda v: [int(x) for x in v.split(".")]
    if want in idx:
        v = want
    elif want and vers and key(want) > key(vers[0]) and "master" in idx:
        v = "master"  # проект требует ещё не вышедший Zig — берём ночную сборку
        info("проекту нужен Zig %s, стабильного ещё нет — беру master %s" % (want, idx["master"].get("version", "")))
    else:
        v = vers[0] if vers else None
    if not v or "x86_64-linux" not in idx[v]:
        raise Fail("не нашёл Zig %s для x86_64-linux" % (want or ""))
    return (idx[v].get("version", v) if v == "master" else v), idx[v]["x86_64-linux"]["tarball"]


def python_runtime(job, minor="3.13"):
    """Переносимый CPython (python-build-standalone) для программы на Python -> путь к распакованному."""
    rel = latest_release("astral-sh/python-build-standalone")
    rx = r"^cpython-%s\.\d+\+\d+-x86_64-unknown-linux-gnu-install_only_stripped\.tar\.gz$" % re.escape(minor)
    cand = pick_assets(rel["assets"] if rel else [], rx)
    if not cand:
        raise Fail("не нашёл python-build-standalone %s" % minor)
    f = os.path.join(job.work, "dl", cand[0][1])
    os.makedirs(os.path.dirname(f), exist_ok=True)
    say("Python для программы: %s" % cand[0][1])
    download(cand[0][2], f)
    with tarfile.open(f) as t:
        t.extractall(os.path.join(job.work, "pyrt"))
    os.remove(f)
    return os.path.join(job.work, "pyrt", "python")


def system_env(job, src, system):
    """Что ещё нужно сборке конкретной системы: версия Zig, свой Python."""
    if system == "zig":
        v, url = zig_release(src)
        info("Zig %s" % v)
        return ["ZIG_VERSION=" + v, "ZIG_URL=" + url]
    if system == "python":
        return ["PYRT=" + python_runtime(job)]
    if system == "node":
        return ["NODERT=" + node_runtime(job)]
    if system == "go":
        return ["ABE_CHROOT=" + chroot_path()]
    return []


def node_runtime(job):
    """Официальный Node.js LTS (собран под glibc 2.28 — как раз Astra 1.7) -> путь к распакованному."""
    body, _ = http_get("https://nodejs.org/dist/index.json")
    lts = [r for r in json.loads(body.decode("utf-8")) if r.get("lts")]
    if not lts:
        raise Fail("не нашёл Node.js LTS")
    v = lts[0]["version"]
    url = "https://nodejs.org/dist/%s/node-%s-linux-x64.tar.xz" % (v, v)
    f = os.path.join(job.work, "dl", os.path.basename(url))
    os.makedirs(os.path.dirname(f), exist_ok=True)
    say("Node.js для программы: %s (LTS)" % v)
    download(url, f)
    with tarfile.open(f) as t:
        t.extractall(os.path.join(job.work, "nodert"))
    os.remove(f)
    return os.path.join(job.work, "nodert", "node-%s-linux-x64" % v)


def prepare_build(job, src, system, repo):
    """Всё для сборки одним вызовом apt: инструменты, build-dep пакета Debian с тем же именем
    (если есть), зависимости из meson.build/CMakeLists.txt/configure.ac."""
    tools = [[pk] for b, pk in TOOLCHAIN[system] if not b or not os.path.exists(job.chroot + "/usr/bin/" + b)]
    pats = scan_build_deps(src, system)
    names = []
    for n in (repo.split("/")[1].lower(), default_name(repo)):
        if n not in names and re.match(r"^[a-z0-9][a-z0-9+.-]+$", n):
            names.append(n)
    if system not in ("meson", "cmake", "autotools", "make", "qmake"):
        names = []  # одноимённый пакет Debian для Rust/Go/Python/Node-проектов почти всегда о другом
    pre = [DEB_SRC_SH,
           'for n in %s; do if [ -n "$(apt-cache showsrc "$n" 2>/dev/null)" ]; then '
           'echo "  apt-get build-dep $n (зависимости сборки пакета Debian)"; '
           'apt-get build-dep -y -qq -o Dpkg::Use-Pty=0 "$n" > .bd.out 2>&1 || tail -n 5 .bd.out; '
           'printf "%%s\\t%%s\\n" "build-dep:$n" "$n" >> .apt-found; break; fi; done'
           % " ".join(shlex.quote(n) for n in names)]
    say("Подготовка сборки: инструменты%s, зависимости из файлов сборки (%d)" % (
        " " + " ".join(t[0] for t in tools) if tools else "", len(pats)))
    found = apt_install_for(pats, job.work, job.log, update=True, groups=tools, pre=pre)
    if found:
        info("поставлено заранее: %s" % ", ".join(sorted(set(found.values()))))


# Пакеты Debian для каждой системы сборки — ставятся, только когда она встретилась.
# Базовые (компилятор C/C++, make, cmake, meson, autotools, pkg-config) ставит install.sh.
# Rust (rustup) и Zig скачиваются в домашнюю папку chroot при первой сборке.
TOOLCHAIN = {
    "cargo": [],
    "go": [("go", "golang-go")],
    "zig": [],
    "stack": [("stack", "haskell-stack"), ("", "libgmp-dev"), ("", "zlib1g-dev"), ("", "libffi-dev"),
              ("", "libncurses-dev")],
    "cabal": [("ghc", "ghc"), ("cabal", "cabal-install"), ("", "libgmp-dev"), ("", "zlib1g-dev"),
              ("", "libffi-dev"), ("", "libncurses-dev")],
    "meson": [("meson", "meson"), ("ninja", "ninja-build")],
    "cmake": [("cmake", "cmake")],
    "autotools": [("autoreconf", "autoconf"), ("automake", "automake"), ("libtoolize", "libtool"),
                  ("autopoint", "autopoint"), ("msgfmt", "gettext"), ("pkg-config", "pkg-config")],
    "qmake": [("qmake6", "qmake6"), ("", "qt6-base-dev")],
    "nim": [("nim", "nim"), ("nimble", "nimble")],
    "dub": [("ldc2", "ldc"), ("dub", "dub")],
    "python": [],
    "node": [],
    "make": [("pkg-config", "pkg-config")],
}


def install_source(repo, name, tag=None, prev_meta=None):
    job = Job(name, "source")
    try:
        src = os.path.join(job.work, "src")
        ref = ["--branch", tag] if tag else []
        say("Исходники %s%s" % (repo, " " + tag if tag else ""))
        clone = ("git clone --depth 1 --recurse-submodules --shallow-submodules %s %s %s && "
                 "git -C %s rev-parse --short HEAD > %s" % (
            " ".join(shlex.quote(r) for r in ref), shlex.quote("%s/%s.git" % (GH_WEB, repo)), shlex.quote(src),
            shlex.quote(src), shlex.quote(os.path.join(job.work, ".commit"))))
        run_env(["bash", "-c", clone], cwd=job.work, log=job.log)
        commit = open(os.path.join(job.work, ".commit")).read().strip()
        version = tag or commit
        system = detect_build_system(src)
        if not system:
            raise Fail("не понял, как собирать. Поддерживаются: " + BUILD_SYSTEMS_TEXT)
        info("система сборки: %s" % system)
        prepare_build(job, src, system, repo)
        extra_env = system_env(job, src, system)
        script = os.path.join(job.work, ".build.sh")
        with open(script, "w") as f:
            f.write(BUILD_SH)
        tried, attempt = set(), 0
        while True:
            attempt += 1
            say("Сборка (попытка %d)" % attempt)
            blog = os.path.join(job.work, "build-%d.log" % attempt)
            rc = run_env(["env", "SRC=" + src, "WORK=" + job.work, "NAME=" + name, "SYSTEM=" + system]
                         + extra_env + ["bash", script], cwd=job.work, log=blog, check=False)
            if rc == 0:
                break
            if attempt >= MAX_BUILD_ATTEMPTS:
                raise Fail("сборка не прошла за %d попыток (журнал: %s)" % (attempt, blog))
            text = open(blog, encoding="utf-8", errors="replace").read()
            pats = dep_patterns_from_log(text, tried)
            groups = [] if pats or system not in C_SYSTEMS else dep_groups_from_errors(text, tried)
            if not pats and not groups and NET_ERR.search(text):
                raise Fail("сборке не удалось скачать зависимости из сети (проверьте интернет/прокси "
                           "и повторите).\n%s\nЖурнал: %s" % (NET_ERR.search(text).group(0), blog))
            if not pats and not groups:
                tail = "\n".join(text.strip().splitlines()[-8:])
                raise Fail("сборка не удалась, а недостающих зависимостей в журнале не видно.\n%s\nЖурнал: %s"
                           % (tail, blog))
            if pats:
                say("Не хватает: %s" % ", ".join(p[0].split(":", 1)[1] for p in pats))
            else:
                say("Пробую пакеты по тексту ошибки: %s" % ", ".join(g[0] for g in groups))
            found = apt_install_for(pats, job.work, job.log, update=False, groups=groups)
            if not found:  # повторять бессмысленно: поставить нечего
                raise Fail("не нашёл пакеты для того, чего не хватает (журнал: %s)" % blog)
            for k, p in found.items():
                ok("%s ← %s" % (k.split(":", 1)[1], p))
            if system == "meson":
                shutil.rmtree(os.path.join(src, "_abe"), ignore_errors=True)
        tree = os.path.join(job.work, "stage", OPT.lstrip("/"), name)
        for alt in ("usr/local", "usr"):  # проекты, которые ставятся мимо PREFIX (qmake и др.)
            if not os.path.isdir(tree) and os.path.isdir(os.path.join(job.work, "stage", alt, "bin")):
                tree = os.path.join(job.work, "stage", alt)
        if not os.path.isdir(tree):
            raise Fail("после сборки не нашёл установленных файлов в %s" % tree)
        return finish_tree_install(job, tree, "github-src:" + repo, version, "", prev_meta)
    except BaseException:
        job.cleanup(keep=True)
        raise


# --- Пакеты Debian -----------------------------------------------------------------------------
HOST_LINK_SKIP = {"doc", "man", "info", "locale", "applications", "icons", "pixmaps", "metainfo", "appdata",
                  "bash-completion", "zsh", "fish", "lintian", "menu", "mime", "glib-2.0", "dbus-1", "polkit-1",
                  "help", "gnome", "themes", "fonts", "sounds", "X11", "xml", "sgml", "common-licenses", "perl5",
                  "pkgconfig", "aclocal", "gtk-doc", "vala", "gir-1.0", "thumbnailers", "systemd", "emacs",
                  "vim", "nano", "apport", "bug", "debhelper", "nautilus", "kservices5", "kio"}


def chroot_dpkg_version(chroot, pkg):
    st = chroot + "/var/lib/dpkg/status"
    if not os.path.exists(st):
        return ""
    cur, ver, inst = None, "", False
    for line in open(st, encoding="utf-8", errors="replace"):
        if line.startswith("Package: "):
            cur, ver, inst = line[9:].strip(), "", False
        elif line.startswith("Status: ") and cur == pkg:
            inst = "installed" in line and "not-installed" not in line
        elif line.startswith("Version: ") and cur == pkg:
            ver = line[9:].strip()
        elif line.strip() == "" and cur == pkg and inst:
            return ver
    return ver if inst else ""


def deb_newer(a, b):
    """a новее b по правилам dpkg."""
    if not b:
        return True
    try:
        return subprocess.call(["dpkg", "--compare-versions", a, "gt", b]) == 0
    except OSError:
        return a > b


def chroot_candidate(chroot, pkg):
    """Самая новая версия пакета в списках apt chroot (без sudo, по уже скачанным спискам)."""
    best = ""
    lists = chroot + "/var/lib/apt/lists"
    if not os.path.isdir(lists):
        return ""
    for fn in os.listdir(lists):
        if not fn.endswith("_Packages"):
            continue
        cur = None
        for line in open(os.path.join(lists, fn), encoding="utf-8", errors="replace"):
            if line.startswith("Package: "):
                cur = line[9:].strip()
            elif cur == pkg and line.startswith("Version: "):
                v = line[9:].strip()
                if deb_newer(v, best):
                    best = v
                cur = None
    return best


def install_debian(pkg, name=None, prev_meta=None, host_links=True):
    name = name or find_by_source("debian:" + pkg) or pkg
    job = Job(name, "debian")
    try:
        say("Пакет Debian %s" % pkg)
        q = shlex.quote
        script = os.path.join(job.work, ".deb.sh")
        with open(script, "w") as f:
            f.write("set -e\nexport DEBIAN_FRONTEND=noninteractive\napt-get update -qq\n"
                    "echo '  apt-get install %s'\n"
                    "apt-get install -y -qq -o Dpkg::Use-Pty=0 %s > .apt.out 2>&1 || { tail -n 30 .apt.out; exit 1; }\n"
                    "dpkg-query -W -f='${Version}' %s > .version\n"
                    "dpkg -L %s > .files\n" % (q(pkg), q(pkg), q(pkg), q(pkg)))
        run_env(["bash", script], root=True, cwd=job.work, log=job.log)
        version = open(os.path.join(job.work, ".version")).read().strip()
        files = [l.strip() for l in open(os.path.join(job.work, ".files")) if l.strip()]
        tree = os.path.join(job.work, "tree")
        os.makedirs(os.path.join(tree, "bin"))
        n_bin = 0
        for p in files:
            full = job.chroot + p
            if not os.path.isfile(full) or os.path.islink(full):
                continue
            if re.match(r"^/(usr/)?(s?bin|games)/[^/]+$", p) and os.access(full, os.X_OK):
                shutil.copy2(full, os.path.join(tree, "bin", os.path.basename(p)))
                n_bin += 1
            m = re.match(r"^/usr/share/(applications|icons|pixmaps|metainfo)/(.+)$", p)
            if m:
                dst = os.path.join(tree, "share", m.group(1), m.group(2))
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                shutil.copy2(full, dst)
        add_alternatives(job.chroot, tree)
        override = None
        if not n_bin:
            # Серверы и инструменты со своим каталогом: /usr/lib/postgresql/18/bin, /usr/libexec/...
            libbins = [p for p in files if re.match(r"^/usr/(lib|libexec)/.+/bin/[^/]+$", p)
                       and os.path.isfile(job.chroot + p) and not os.path.islink(job.chroot + p)
                       and os.access(job.chroot + p, os.X_OK)]
            if not libbins:
                raise Fail("в пакете %s нет программ — это библиотека или данные?" % pkg)
            tree = os.path.join(job.work, "full")
            copy_usr_tree(job.chroot, files, tree)
            override = sorted(os.path.relpath(p, "/usr") for p in libbins)
            info("программы не в /usr/bin: пакет копируется целиком с раскладкой /usr (%d команд)" % len(override))
            host_links = False
        links = []
        if host_links:
            for p in files:
                m = re.match(r"^(/usr/share|/usr/lib/x86_64-linux-gnu|/usr/lib)/([^/]+)$", p)
                if not m or m.group(2) in HOST_LINK_SKIP or not os.path.isdir(job.chroot + p) or os.path.islink(job.chroot + p):
                    continue
                if not os.path.lexists(p):
                    links.append(p)
        meta_extra_notes = ["данные программы остаются в chroot"]
        if links:
            say("Каталоги данных, которые программа ищет по жёсткому пути — ссылки на хосте (sudo)")
            for p in links:
                info("%s → %s%s" % (p, job.chroot, p))
            made = []
            for p in links:
                if host_link(job.chroot + p, p):
                    made.append(p)
            if made:
                with open(os.path.join(job.work, ".host-links"), "w") as f:
                    f.write("\n".join(made) + "\n")
        name = finish_tree_install(job, tree, "debian:" + pkg, version, "", prev_meta, meta_extra_notes, cleanup=False,
                                   links_override=override)
        hl = os.path.join(job.work, ".host-links")
        if os.path.exists(hl):
            old = os.path.join(app_dir(name), ".host-links")
            prev = set(open(old).read().split()) if os.path.exists(old) else set()
            with open(old, "w") as f:
                f.write("\n".join(sorted(prev | set(open(hl).read().split()))) + "\n")
        job.cleanup()
        return name
    except BaseException:
        job.cleanup(keep=True)
        raise


def chroot_resolve(chroot, path, depth=10):
    """realpath внутри chroot: абсолютные ссылки считаются от корня chroot."""
    for _ in range(depth):
        full = chroot + path
        if not os.path.islink(full):
            return path
        t = os.readlink(full)
        path = t if t.startswith("/") else os.path.normpath(os.path.join(os.path.dirname(path), t))
    return path


def add_alternatives(chroot, tree):
    """Команды через update-alternatives (/usr/bin/figlet -> /etc/alternatives/figlet -> figlet-figlet)
    не входят в список файлов пакета — добавляем их как ссылки на скопированные программы."""
    bind = os.path.join(tree, "bin")
    have = set(os.listdir(bind)) if os.path.isdir(bind) else set()
    for d in ("/usr/bin", "/usr/sbin", "/usr/games"):
        if not os.path.isdir(chroot + d):
            continue
        for f in os.listdir(chroot + d):
            p = d + "/" + f
            if f in have or not os.path.islink(chroot + p):
                continue
            if "/etc/alternatives/" not in os.readlink(chroot + p) and not os.readlink(chroot + p).startswith("/etc/alternatives"):
                continue
            t = chroot_resolve(chroot, p)
            if os.path.dirname(t) in ("/usr/bin", "/usr/sbin", "/usr/games", "/bin") and os.path.basename(t) in have:
                os.symlink(os.path.basename(t), os.path.join(bind, f))
                have.add(f)


def copy_usr_tree(chroot, files, tree):
    """Файлы пакета из /usr с сохранением раскладки: программы вроде PostgreSQL находят
    свои lib/ и share/ относительно каталога bin, так что раскладку нужно повторить."""
    for p in files:
        if not p.startswith("/usr/") or re.match(r"^/usr/share/(doc|man|lintian|bug|info)/", p):
            continue
        src, dst = chroot + p, os.path.join(tree, os.path.relpath(p, "/usr"))
        if os.path.islink(src):
            t = os.readlink(src)
            if t.startswith("/usr/"):
                t = os.path.relpath(os.path.join(tree, os.path.relpath(t, "/usr")), os.path.dirname(dst))
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            if not os.path.lexists(dst):
                os.symlink(t, dst)
        elif os.path.isdir(src):
            os.makedirs(dst, exist_ok=True)
        elif os.path.isfile(src):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.copy2(src, dst)


def debian_search(q, limit=30):
    chroot = chroot_path()
    lists = chroot + "/var/lib/apt/lists"
    res, rx = [], re.compile(re.escape(q), re.I)
    if not os.path.isdir(lists):
        return res
    for fn in sorted(os.listdir(lists)):
        if not fn.endswith("_Packages"):
            continue
        pkg, desc, sec = None, "", ""
        for line in open(os.path.join(lists, fn), encoding="utf-8", errors="replace"):
            if line.startswith("Package: "):
                pkg, desc, sec = line[9:].strip(), "", ""
            elif line.startswith("Section: "):
                sec = line[9:].strip()
            elif line.startswith("Description: "):
                desc = line[13:].strip()
                if pkg and (rx.search(pkg) or rx.search(desc)) and not re.search(r"(-dev|-doc|-dbg|-data|-common|^lib)", pkg) \
                        and not sec.startswith(("libs", "libdevel", "oldlibs", "doc", "debug")):
                    res.append({"kind": "debian", "spec": "deb:" + pkg, "name": pkg, "description": desc})
                    if len(res) >= limit * 4:
                        break
    res.sort(key=lambda r: (r["name"] != q, not r["name"].startswith(q), len(r["name"])))
    seen, out = set(), []
    for r in res:
        if r["name"] not in seen:
            seen.add(r["name"])
            out.append(r)
    return out[:limit]


def github_search(q, limit=10):
    try:
        j = gh_json("/search/repositories?" + urllib.parse.urlencode({"q": q, "per_page": limit}))
    except (urllib.error.URLError, ValueError):
        return []
    return [{"kind": "github", "spec": r["full_name"], "name": r["full_name"],
             "description": (r.get("description") or "")[:200], "stars": r.get("stargazers_count", 0)}
            for r in j.get("items", [])]


# --- Команды -----------------------------------------------------------------------------------
def cmd_install(a):
    kind, val = parse_spec(a.spec)
    if a.name:
        check_name(a.name)
    if kind == "name" and preset_for(val):
        pname, src, rx = preset_for(val)
        info("известная программа: %s" % src)
        return install_github(src.split(":", 1)[1], a.name or pname, a.asset or rx, a.source, a.force)
    if kind == "name":
        if chroot_candidate(chroot_path(), val) or chroot_dpkg_version(chroot_path(), val):
            kind = "debian"
        else:
            hits = debian_search(val, 5)
            msg = "«%s» — не ссылка на GitHub и не пакет Debian." % val
            if hits:
                msg += " Похожие пакеты: " + ", ".join(h["name"] for h in hits)
            raise Fail(msg + "  Поиск: astra-get search %s" % val)
    if kind == "github":
        return install_github(val, a.name, a.asset, a.source, a.force)
    if kind == "debian":
        return install_debian(val, a.name, host_links=not a.no_host_links)
    if kind == "url":
        return install_url(val, a.name)


def fetch_url(url):
    """Скачивает файл по ссылке -> (путь, имя файла, версия). Версия: из .deb или sha256 файла."""
    fn = urllib.parse.unquote(url.rsplit("/", 1)[-1].split("?")[0]) or "download"
    d = os.path.join(CACHE, "dl")
    os.makedirs(d, exist_ok=True)
    f = os.path.join(d, fn)
    say("Скачиваю %s" % url)
    download(url, f)
    ok("скачано (%d МБ)" % (os.path.getsize(f) >> 20))
    ver = deb_field(f, "Version") if fn.lower().endswith(".deb") else ""
    if not ver:
        h = hashlib.sha256()
        with open(f, "rb") as fh:
            for chunk in iter(lambda: fh.read(1 << 20), b""):
                h.update(chunk)
        ver = "sha256:" + h.hexdigest()[:12]
    return f, fn, ver


def install_url(url, name=None, prev_meta=None, force=True):
    f, fn, ver = fetch_url(url)
    if not name:
        name = (deb_field(f, "Package") if fn.lower().endswith(".deb") else "") or \
            re.sub(r"[-_.]?(v?\d[\w.]*)?([-_.](linux|amd64|x86_64|x64).*)?\.(deb|tar\..*|tgz|zip|appimage)$",
                   "", fn, flags=re.I).lower() or "app"
        name = find_by_source("url:" + url) or name
    check_name(name)
    if prev_meta and prev_meta.get("VERSION") == ver and not force:
        ok("%s: уже последняя версия %s" % (name, ver))
        os.remove(f)
        return name
    rel = {"tag": ver, "assets": [(fn, url)]}
    say("%s %s" % (name, ver))
    return install_release(url, rel, fn, url, name, prev_meta=prev_meta, source="url:" + url, local=f)


def check_updates(names=None, quiet=False):
    """-> список dict(name, source, installed, latest, update)."""
    out = []
    chroot = chroot_path()
    for n in names or installed():
        m = load_meta(n)
        r = {"name": n, "source": m["SOURCE"], "installed": m["VERSION"], "latest": "", "update": False, "error": ""}
        src = m["SOURCE"]
        try:
            if src.startswith("github:"):
                rel = latest_release(src[7:])
                if rel:
                    r["latest"] = rel["tag"]
            elif src.startswith("github-src:"):
                repo = src[11:]
                rel = latest_release(repo)
                if rel:
                    r["latest"] = rel["tag"]
                else:
                    j = gh_json("/repos/%s/commits?per_page=1" % repo)
                    r["latest"] = j[0]["sha"][:7] if j else ""
            elif src.startswith("debian:"):
                r["latest"] = chroot_candidate(chroot, src[7:]) or chroot_dpkg_version(chroot, src[7:])
        except (Fail, urllib.error.URLError, ValueError, KeyError, IndexError) as e:
            r["error"] = str(e)
        r["update"] = bool(r["latest"]) and r["latest"] != r["installed"]
        out.append(r)
    return out


def update_one(n, force=False):
    m = load_meta(n)
    src = m["SOURCE"]
    if not src:
        p = PRESETS.get(n)
        if not p:
            raise Fail("%s: неизвестно, откуда обновлять (astra-get track %s ИСТОЧНИК)" % (n, n))
        m["SOURCE"], m["ASSET"] = p
        src = p[0]
    if not m["OPTS"]:
        m["OPTS"] = install_opts_of(n)
    if src.startswith("github:"):
        repo = src[7:]
        rel = latest_release(repo)
        if not rel:
            raise Fail("%s: у %s больше нет релизов" % (n, repo))
        if rel["tag"] == m["VERSION"] and not force:
            ok("%s: уже последняя версия %s" % (n, rel["tag"]))
            return
        cand = pick_assets(rel["assets"], m["ASSET"] or None, repo)
        if not cand:
            raise Fail("%s: в релизе %s нет подходящего файла" % (n, rel["tag"]))
        install_release(repo, rel, cand[0][1], cand[0][2], n, prev_meta=m, regex=m["ASSET"])
    elif src.startswith("github-src:"):
        repo = src[11:]
        rel = latest_release(repo)
        install_source(repo, n, rel["tag"] if rel else None, prev_meta=m)
    elif src.startswith("debian:"):
        install_debian(src[7:], n, prev_meta=m)
    elif src.startswith("url:"):
        install_url(src[4:], n, prev_meta=m, force=force)
    else:
        raise Fail("%s: источник %s обновлять не умею" % (n, src))


def install_opts_of(n):
    f = os.path.join(app_dir(n), ".install-opts")
    if not os.path.isfile(f):
        return []
    out = subprocess.check_output(["bash", "-c", 'OPTS=(); . "$1"; printf "%s\\0" "${OPTS[@]}"', "x", f])
    return [o for o in out.decode("utf-8", "replace").split("\0") if o]


def cmd_update(a):
    names = a.names
    if a.check or not names and not a.all:
        res = check_updates(names or None)
        if JSON_MODE:
            print(json.dumps(res, ensure_ascii=False))
            return
        say("Программы build-env")
        for r in res:
            if r["source"].startswith("url:"):
                print("  %-16s %s" % (r["name"], (r["installed"] or "?") + _c("2", "  (по ссылке: astra-get update %s скачает и сравнит)" % r["name"])))
            elif not r["source"]:
                hint = "  (известная: astra-get track %s)" % r["name"] if r["name"] in PRESETS else ""
                print("  %-16s %s%s" % (r["name"], _c("2", "источник не задан"), hint))
            elif r["error"]:
                print("  %-16s %s" % (r["name"], _c("33", "ошибка проверки: " + r["error"][:80])))
            elif r["update"]:
                print("  %-16s %s" % (r["name"], _c("1;33", "%s → %s" % (r["installed"] or "?", r["latest"]))))
            else:
                print("  %-16s %s" % (r["name"], _c("32", (r["installed"] or "?") + "  актуальная")))
        if any(r["update"] for r in res):
            print("\nПоставить: astra-get update --all  (или astra-get update ИМЯ)")
        return
    if a.all:
        names = [r["name"] for r in check_updates() if r["update"]]
        if not names:
            ok("обновлений нет")
            return
    failed = []
    for n in names:
        try:
            update_one(n, force=bool(a.names))
        except Fail as e:
            warn(str(e))
            failed.append(n)
    if failed:
        raise Fail("не обновились: " + ", ".join(failed))


def cmd_remove(a):
    for n in a.names:
        check_name(n)
        d = app_dir(n)
        if not os.path.isdir(d):
            raise Fail("%s не установлен" % n)
        hl = os.path.join(d, ".host-links")
        links = open(hl).read().split() if os.path.exists(hl) else []
        subprocess.check_call([tool("install-binary-from-build-env"), "--remove", n])
        for p in links:
            if os.path.islink(p) and os.readlink(p).startswith(chroot_path()):
                host_unlink(p)
                info("удалена ссылка %s" % p)
        shutil.rmtree(os.path.join(OPT, "." + n + ".prev"), ignore_errors=True)
        wl = webkit_link(n)
        if os.path.islink(wl) and os.readlink(wl).startswith(d + "/"):
            os.remove(wl)
        ok("%s удалён" % n)


def cmd_rollback(a):
    n = a.name
    check_name(n)
    d, p = app_dir(n), os.path.join(OPT, "." + n + ".prev")
    if not os.path.isdir(p):
        raise Fail("для %s нет сохранённой прошлой версии" % n)
    tmp = d + ".rb.%d" % os.getpid()
    os.rename(d, tmp)
    os.rename(p, d)
    shutil.rmtree(tmp, ignore_errors=True)
    ok("%s: возвращена версия %s" % (n, load_meta(n)["VERSION"] or "?"))


def app_list():
    res = []
    for n in installed():
        m = load_meta(n)
        d = app_dir(n)
        links = []
        lf = os.path.join(d, ".links")
        if os.path.exists(lf):
            links = [l.strip() for l in open(lf) if l.strip()]
        cmds = [l for l in links if l.startswith(BIN + "/")]
        desk = [l for l in links if l.endswith(".desktop")]
        res.append({"name": n, "version": m["VERSION"], "source": m["SOURCE"], "commands": cmds, "desktop": desk,
                    "rollback": os.path.isdir(os.path.join(OPT, "." + n + ".prev"))})
    return res


def cmd_list(a):
    res = app_list()
    if JSON_MODE:
        print(json.dumps(res, ensure_ascii=False))
        return
    if not res:
        print("Ничего не установлено. Пример: astra-get install https://github.com/sharkdp/bat")
    for r in res:
        print("%-16s %-14s %s" % (r["name"], r["version"] or "?", r["source"] or _c("2", "(источник не задан)")))
        for c in r["commands"]:
            print("    → " + c)


def cmd_search(a):
    res = debian_search(a.query, a.limit) + ([] if a.no_github else github_search(a.query, a.limit))
    if JSON_MODE:
        print(json.dumps(res, ensure_ascii=False))
        return
    for r in res:
        star = " ★%d" % r["stars"] if r.get("stars") else ""
        print("%-38s %s" % (r["spec"] + star, r["description"][:90]))
    if not res:
        print("Ничего не нашлось.")


def cmd_resolve(a):
    """Что будет установлено (для GUI и проверки перед установкой)."""
    kind, val = parse_spec(a.spec)
    r = {"spec": a.spec, "kind": kind, "target": val}
    if kind == "name" and preset_for(val):
        pname, src, rx = preset_for(val)
        kind, r["kind"], r["target"] = "github", "github", src.split(":", 1)[1]
        val, a.asset = r["target"], a.asset or rx
        r["preset"] = pname
    if kind == "name":
        ch = chroot_path()
        if chroot_candidate(ch, val) or chroot_dpkg_version(ch, val):
            kind = r["kind"] = "debian"
    if kind == "github":
        rel = latest_release(val)
        r["name"] = r.get("preset") or find_by_source("github:" + val) or find_by_source("github-src:" + val) \
            or default_name(val)
        if rel:
            cand = pick_assets(rel["assets"], a.asset, val)
            r["version"] = rel["tag"]
            r["assets"] = [{"name": c[1], "url": c[2], "score": c[0]} for c in cand]
            r["all_assets"] = [n for n, _ in rel["assets"]]
            r["method"] = "release" if cand else "source"
        else:
            r["method"], r["version"], r["assets"] = "source", "", []
    elif kind == "debian":
        ch = chroot_path()
        r["name"] = find_by_source("debian:" + val) or val
        r["version"] = chroot_candidate(ch, val) or chroot_dpkg_version(ch, val)
        r["method"] = "debian"
    elif kind == "url":
        r["method"], r["name"] = "url", re.sub(r"\W.*$", "", val.rsplit("/", 1)[-1]).lower()
    else:
        r["method"] = "unknown"
        r["suggest"] = debian_search(val, 8)
    r["installed"] = bool(r.get("name")) and os.path.isdir(app_dir(r["name"]))
    if JSON_MODE:
        print(json.dumps(r, ensure_ascii=False))
    else:
        for k, v in r.items():
            if k not in ("all_assets",):
                print("%-10s %s" % (k, v if not isinstance(v, list) else ", ".join(x.get("name", str(x)) if isinstance(x, dict) else str(x) for x in v[:6])))


def cmd_track(a):
    n = a.name
    check_name(n)
    if not os.path.isdir(app_dir(n)):
        raise Fail("%s не установлен" % n)
    m = load_meta(n)
    if a.source:
        k, v = parse_spec(a.source)
        if k == "github":
            m["SOURCE"] = ("github-src:" if a.from_source else "github:") + v
        elif k == "debian":
            m["SOURCE"] = "debian:" + v
        else:
            raise Fail("источник: github:владелец/репо, ссылка на GitHub или deb:пакет")
    elif n in PRESETS:
        m["SOURCE"], m["ASSET"] = PRESETS[n]
    elif not m["SOURCE"]:
        raise Fail("укажите источник: astra-get track %s https://github.com/владелец/репо" % n)
    if a.asset:
        m["ASSET"] = a.asset
    if a.version:
        m["VERSION"] = a.version
    if not m["OPTS"]:
        m["OPTS"] = install_opts_of(n)
    save_meta(n, m)
    ok("%s: источник %s, версия %s" % (n, m["SOURCE"], m["VERSION"] or "неизвестна"))


def cmd_run(a):
    for r in app_list():
        if r["name"] == a.name and r["commands"]:
            os.execv(r["commands"][0], [r["commands"][0]] + a.args)
    raise Fail("у %s нет команды для запуска" % a.name)


def main():
    global JSON_MODE, PROGRESS_LINES
    ap = argparse.ArgumentParser(
        prog="astra-get", description="Пакетный менеджер для Astra Linux поверх astra-chroot-build-env",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""примеры:
  astra-get install https://github.com/sharkdp/bat     готовый релиз (.deb, архив, AppImage)
  astra-get install htop-dev/htop                      нет сборки под Linux -> из исходников
  astra-get install deb:krita                          пакет Debian trixie
  astra-get search markdown                            поиск в Debian и на GitHub
  astra-get update                                     есть ли обновления
  astra-get update --all                               поставить все обновления
  astra-get-gui                                        окно""")
    ap.add_argument("--json", action="store_true", help="вывод в JSON (для GUI и скриптов)")
    ap.add_argument("--progress-lines", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("-V", "--version", action="version", version="astra-get " + VERSION)
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("install", help="установить по ссылке, owner/repo или deb:пакет")
    p.add_argument("spec")
    p.add_argument("--name", help="имя программы (по умолчанию из репозитория)")
    p.add_argument("--asset", help="регулярное выражение файла релиза")
    p.add_argument("--source", action="store_true", help="собрать из исходников, даже если есть релиз")
    p.add_argument("--no-host-links", action="store_true", help="для deb: не создавать ссылки на каталоги данных")
    p.add_argument("--force", action="store_true", help="заменить программу с тем же именем из другого источника")
    p = sub.add_parser("remove", help="удалить")
    p.add_argument("names", nargs="+")
    p = sub.add_parser("list", help="что установлено")
    p = sub.add_parser("update", help="проверить или поставить обновления")
    p.add_argument("names", nargs="*")
    p.add_argument("--all", action="store_true", help="поставить все доступные обновления")
    p.add_argument("--check", action="store_true", help="только проверить")
    p = sub.add_parser("rollback", help="вернуть версию до последнего обновления")
    p.add_argument("name")
    p = sub.add_parser("search", help="поиск программ в Debian trixie и на GitHub")
    p.add_argument("query")
    p.add_argument("--limit", type=int, default=15)
    p.add_argument("--no-github", action="store_true")
    p = sub.add_parser("resolve", help="показать, что и как будет установлено")
    p.add_argument("spec")
    p.add_argument("--asset")
    p = sub.add_parser("track", help="задать источник обновлений для уже установленной программы")
    p.add_argument("name")
    p.add_argument("source", nargs="?")
    p.add_argument("--asset")
    p.add_argument("--version")
    p.add_argument("--from-source", action="store_true")
    p = sub.add_parser("run", help="запустить установленную программу")
    p.add_argument("name")
    p.add_argument("args", nargs=argparse.REMAINDER)
    a = ap.parse_args()
    JSON_MODE, PROGRESS_LINES = a.json, a.progress_lines
    if not a.cmd:
        ap.print_help()
        return 0
    if os.geteuid() == 0:
        raise Fail("запускайте от обычного пользователя, sudo astra-get спросит сам")
    os.makedirs(CACHE, exist_ok=True)
    fn = {"install": cmd_install, "remove": cmd_remove, "list": cmd_list, "update": cmd_update,
          "rollback": cmd_rollback, "search": cmd_search, "resolve": cmd_resolve, "track": cmd_track,
          "run": cmd_run}[a.cmd]
    fn(a)
    return 0


if __name__ == "__main__":
    try:
        try:
            rc = main()
        finally:
            SESSION.close()
        sys.exit(rc)
    except Fail as e:
        if JSON_MODE:
            print(json.dumps({"error": str(e)}, ensure_ascii=False))
        print(_c("31", "Ошибка: ") + str(e), file=sys.stderr)
        sys.exit(1)
    except urllib.error.HTTPError as e:
        print(_c("31", "Ошибка: ") + "сервер ответил %s на %s" % (e.code, e.geturl()), file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(_c("31", "Ошибка сети: ") + str(e.reason), file=sys.stderr)
        sys.exit(1)
    except subprocess.CalledProcessError as e:
        print(_c("31", "Ошибка: ") + "команда завершилась с кодом %d: %s" % (e.returncode, " ".join(map(str, e.cmd))), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
